@model List<FShop6.Areas.Admin.Models.TaiKhoanViewModel>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Họ tên</th>
            <th>Email</th>
            <th>Điện thoại</th>
            <th>Địa chỉ</th>
            <th>Vai trò</th>
            <th>Trạng thái</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
                <tr>
                    <td>@item.HoTen</td>
                    <td>@item.Email</td>
                    <td>@item.SoDienThoai</td>
                    <td>@item.DiaChi</td>
                    <td>@item.TenVaiTro</td>
                        <td>
                    @if (item.TTHoatDong=="True")
                    {
                <span class="badge badge-success">Hoạt động</span>
                    }
                    else
                    {
                <span class="badge badge-danger">Khóa</span>
                    }
    </td>

                </tr>
        }
    </tbody>
</table>
