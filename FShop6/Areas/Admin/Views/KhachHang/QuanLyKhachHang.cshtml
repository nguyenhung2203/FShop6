@{
    Layout = "~/Areas/Admin/Views/Shared/CustomerLayout.cshtml";
    ViewData["Title"] = "Quản lý khách hàng";
}
@model List<FShop6.Areas.Admin.Models.NguoiDungViewModel>

<div id="content-wrapper">
    <div class="container-fluid">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Admin/TrangChu">Trang chủ</a></li>
            <li class="breadcrumb-item active">Quản lý khách hàng</li>
        </ol>

        <div class="card mb-3">
            <div class="card-header bg-primary text-white">
                <i class="fa fa-users"></i> Quản lý khách hàng
            </div>
            <div class="card-body">
                @if (TempData["ThongBao"] != null)
                {
                    <div class="alert alert-success">@TempData["ThongBao"]</div>
                }
                @if (TempData["Loi"] != null)
                {
                    <div class="alert alert-danger">@TempData["Loi"]</div>
                }

                <div class="table-responsive">
                    <table class="table table-bordered" id="customerTable" width="100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th>Họ tên</th>
                                <th>Email</th>
                                <th>Số điện thoại</th>
                                <th>Địa chỉ</th>
                                <th>Mật khẩu</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.HoTen</td>
                                    <td>@item.Email</td>
                                    <td>@item.SDT</td>
                                    <td>@item.DiaChi</td>
                                    <td>******</td>
                                    <td>
                                        @{
                                            var status = (item.TTHoatDong ?? "").Trim().ToLower();
                                            if (status == "hoạt động")
                                            {
                                                <span class="badge badge-success">Hoạt động</span>
                                            }
                                            else if (status == "tạm khóa" || status == "tạm khoá")
                                            {
                                                <span class="badge badge-secondary">Tạm khóa</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-warning">@item.TTHoatDong</span>
                                            }
                                        }
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-info" data-toggle="modal" data-target="#editCustomerModal"
                                                data-id="@item.MaNguoiDung"
                                                data-status="@item.TTHoatDong"
                                                data-password="@item.MatKhauThuc">
                                            <i class="fa fa-pencil"></i> Sửa
                                        </button>
                                        <button class="btn btn-sm btn-danger" data-toggle="modal" data-target="#deleteCustomerModal"
                                                data-id="@item.MaNguoiDung">
                                            <i class="fa fa-trash"></i> Xóa
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer small text-muted">Cập nhật gần đây</div>
        </div>

        <!-- Modal sửa -->
        <div class="modal fade" id="editCustomerModal" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog" role="document">
                <form action="@Url.Action("ChinhSua", "KhachHang", new { area = "Admin" })" method="post" class="modal-content">
                    <div class="modal-header bg-info text-white">
                        <h5 class="modal-title">Sửa thông tin khách hàng</h5>
                        <button class="close text-white" type="button" data-dismiss="modal"><span>×</span></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="edit_customer_id" name="MaNguoiDung" />
                        <div class="form-group">
                            <label for="edit_customer_password">Mật khẩu</label>
                            <div class="input-group">
                                <input type="password" class="form-control" id="edit_customer_password" name="MatKhau" required />
                                <div class="input-group-append">
                                    <span class="input-group-text" id="togglePassword" style="cursor:pointer;">
                                        <i class="fa fa-eye-slash"></i> <!-- Mặc định mắt đóng -->
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="edit_customer_status">Trạng thái</label>
                            <select class="form-control" id="edit_customer_status" name="TTHoatDong">
                                <option value="Hoạt động">Hoạt động</option>
                                <option value="Tạm khóa">Tạm khóa</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" type="button" data-dismiss="modal">Hủy</button>
                        <button class="btn btn-info" type="submit">Lưu thay đổi</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Modal xóa -->
        <div class="modal fade" id="deleteCustomerModal" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog" role="document">
                <form action="@Url.Action("XoaNguoiDung", "KhachHang", new { area = "Admin" })"
                      method="post" class="modal-content">
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title">Xóa khách hàng</h5>
                        <button class="close text-white" type="button" data-dismiss="modal"><span>×</span></button>
                    </div>
                    <div class="modal-body">
                        Bạn có chắc chắn muốn xóa khách hàng này?
                        <input type="hidden" id="customerIdToDelete" name="maNguoiDung" />
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" type="button" data-dismiss="modal">Hủy</button>
                        <button class="btn btn-danger" type="submit">Xóa</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $('#editCustomerModal').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget);
            var id = button.data('id');
            var status = button.data('status');
            var password = button.data('password');

            $('#edit_customer_id').val(id);
            $('#edit_customer_status').val(status);
            $('#edit_customer_password').val(password);

            // Mặc định ẩn mật khẩu và icon là mắt đóng
            $('#edit_customer_password').attr('type', 'password');
            $('#togglePassword i').removeClass('fa-eye').addClass('fa-eye-slash');
        });

        $('#deleteCustomerModal').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget);
            var id = button.data('id');
            $('#customerIdToDelete').val(id);
        });

        // Toggle mật khẩu theo ý bạn
        $('#togglePassword').on('click', function () {
            var input = $('#edit_customer_password');
            var icon = $(this).find('i');
            if (input.attr('type') === 'password') {
                input.attr('type', 'text');
                icon.removeClass('fa-eye-slash').addClass('fa-eye'); // Mắt mở khi hiện mật khẩu
            } else {
                input.attr('type', 'password');
                icon.removeClass('fa-eye').addClass('fa-eye-slash'); // Mắt đóng khi ẩn mật khẩu
            }
        });
    </script>
}
