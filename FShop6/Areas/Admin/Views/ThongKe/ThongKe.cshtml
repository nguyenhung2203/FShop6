@{
	Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
	ViewData["Title"] = "Thống kê";
}
<main>
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="index.html">Trang chủ</a>
        </li>
        <li class="breadcrumb-item active">Thống kê đơn hàng</li>
    </ol>
    <!-- Biểu đồ thống kê -->
    <div class="card mb-3">
        <div class="card-header bg-info text-white">
            <i class="fa fa-bar-chart"></i>
            Biểu đồ doanh thu theo tháng (Cột)
        </div>
        <div class="card-body">
            <canvas id="revenueBarChart" width="100%" height="40"></canvas>
        </div>
    </div>
    <!-- Bảng doanh thu theo ngày -->
    <div class="card mb-3">
        <div class="card-header bg-success text-white">
            <i class="fa fa-calendar"></i>
            Bảng doanh thu theo ngày
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dailyRevenueTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Ngày</th>
                            <th>Tổng doanh thu</th>
                            <th>Số đơn hàng</th>
                            <th>Ghi chú</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Ví dụ dữ liệu -->
                        <tr>
                            <td>20/07/2025</td>
                            <td>12,000,000</td>
                            <td>15</td>
                            <td>Doanh thu cao nhất tuần</td>
                        </tr>
                        <tr>
                            <td>19/07/2025</td>
                            <td>8,500,000</td>
                            <td>10</td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>18/07/2025</td>
                            <td>9,200,000</td>
                            <td>12</td>
                            <td></td>
                        </tr>
                        <!-- ...thêm dữ liệu khác... -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</main>