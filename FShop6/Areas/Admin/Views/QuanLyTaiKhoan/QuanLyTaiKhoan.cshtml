@{
    Layout = "~/Areas/Admin/Views/Shared/CustomerLayout.cshtml";
    ViewData["Title"] = "Quản lý tài khoản";
}
@model List<FShop6.Areas.Admin.Models.TaiKhoanViewModel>

<div id="content-wrapper">
    <div class="container-fluid">
        <!-- Breadcrumbs -->
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="index.html">Trang chủ</a>
            </li>
            <li class="breadcrumb-item active">Quản lý tài khoản</li>
        </ol>

        <!-- Quản lý tài khoản admin -->
        <div class="card mb-3">
            <div class="card-header bg-primary text-white">
                <i class="fa fa-user"></i> Quản lý tài khoản
                <a href="#" class="text-white" data-toggle="modal" data-target="#addAdminModal">
                </a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered" id="adminTable" width="100%" cellspacing="0">
                        <thead>
                            <thead>
    <tr>
        <th>Mã người dùng</th>
        <th>Tài khoản</th>
                <th>Mật khẩu</th>
        <th>Email</th>
        <th>Số điện thoại</th>
        <th>Quyền hạn</th>
        <th>Trạng thái</th>
        <th>Thao tác</th>
    </tr>
</thead>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Where(x => x.TenVaiTro?.Trim().ToLower() == "nhân viên"))
                            {
                                    <tr>
                                               <td>@item.MaNguoiDung</td>
                                            <td>@item.TaiKhoan</td>
                                                <td>@item.MatKhau</td>
                                        <td>@item.Email</td>
                                            <td>@item.SoDienThoai</td>
                                        <td>@item.TenVaiTro</td>
                                        <td>
                                                
                                        @{
                                            var rawStatus = item.TTHoatDong ?? "";
                                            var status = rawStatus.Trim().ToLowerInvariant();

                                            if (status == "hoạt động")
                                            {
                    <span class="badge badge-success">Hoạt động</span>
                                            }
                                            else if (status == "tạm khóa" || status == "tạm khoá") // cả 2 kiểu gõ khoá
                                            {
                    <span class="badge badge-secondary">Tạm khóa</span>
                                            }
                                            else
                                            {
                    <span class="badge badge-warning">@rawStatus</span> <!-- fallback nếu có giá trị lạ -->
                                            }
                                        }
   

                                        <td>
                                                <button class="btn btn-sm btn-info" data-toggle="modal" data-target="#editStatusModal"
            data-id="@item.MaNguoiDung"
            data-status="@item.TTHoatDong">
        <i class="fa fa-pencil"></i> Sửa
    </button>

                                                <button class="btn btn-sm btn-danger" data-toggle="modal" data-target="#deleteAdminModal"
            data-id="@item.MaNguoiDung">
        <i class="fa fa-trash"></i> Xóa
    </button>
                                        </td>
                                    </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <!-- sửa -->
       <!-- Sửa tài khoản -->
<div class="modal fade" id="editStatusModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <form action="@Url.Action("CapNhatTrangThai", "QuanLyTaiKhoan", new { area = "Admin" })"
                              method="post" class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">Cập nhật trạng thái</h5>
                <button class="close text-white" type="button" data-dismiss="modal"><span>×</span></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="MaNguoiDung" id="edit_user_id" />
                <div class="form-group">
                    <label for="edit_status">Trạng thái</label>
                    <select class="form-control" id="edit_status" name="TTHoatDong">
                        <option value="Hoạt động">Hoạt động</option>
                        <option value="Tạm khóa">Tạm khóa</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="edit_password">Mật khẩu mới</label>
                    <input type="text" class="form-control" id="edit_password" name="MatKhau" placeholder="Để trống nếu không đổi mật khẩu">
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" type="button" data-dismiss="modal">Hủy</button>
                <button class="btn btn-primary" type="submit">Lưu thay đổi</button>
            </div>
        </form>
    </div>
</div>


<!-- Xóa tài khoản -->
<div class="modal fade" id="deleteAdminModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <form action="@Url.Action("XoaTaiKhoan", "QuanLyTaiKhoan", new { area = "Admin" })"
      method="post" class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Xóa tài khoản</h5>
                <button class="close text-white" type="button" data-dismiss="modal"><span>×</span></button>
            </div>
            <div class="modal-body">
                Bạn có chắc chắn muốn xóa tài khoản này ?
                <input type="hidden" id="userIdToDelete" name="MaNguoiDung" />
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" type="button" data-dismiss="modal">Hủy</button>
                <button class="btn btn-danger" type="submit">Xóa</button>
            </div>
        </form>
    </div>
</div>

        @section Scripts {
        <script>
            $('#editStatusModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var id = button.data('id');
                var status = button.data('status');

                $('#edit_user_id').val(id);
                $('#edit_status').val(status);
            });
            $('#deleteAdminModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var id = button.data('id');
                $('#userIdToDelete').val(id);
                $('#userIdToDeleteDisplay').text(id);
            });
        </script>
}
