@{
    Layout = "~/Areas/Admin/Views/Shared/CustomerLayout.cshtml";
    ViewData["Title"] = "Hồ sơ Admin";
}
<!-- Nội dung chính - Hồ sơ Admin -->
<main>
    <div class="container-fluid">
        <!-- Breadcrumbs-->
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="index.html">Trang chủ</a>
            </li>
            <li class="breadcrumb-item active">Hồ sơ admin</li>
        </ol>

        <!-- Admin Profile Card -->
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow mb-4">
                    <div class="card-body text-center">
                        <img src="https://i.imgur.com/4M34hi2.png" class="rounded-circle mb-3" width="120" alt="Admin Avatar">
                        <h3 class="card-title mb-1">Thanh Tai</h3>
                        <p class="text-muted mb-2">Quản trị viên hệ thống</p>
                        <div class="row mb-3">
                            <div class="col-md-6 text-left">
                                <p><i class="fa fa-envelope mr-2"></i> rao.ahmed@email.com</p>
                                <p><i class="fa fa-phone mr-2"></i> 0123 456 789</p>
                                <p><i class="fa fa-map-marker mr-2"></i> Hà Nội, Việt Nam</p>
                            </div>
                            <div class="col-md-6 text-left">
                                <p><i class="fa fa-calendar mr-2"></i> Ngày tham gia: 01/01/2022</p>
                                <p><i class="fa fa-clock-o mr-2"></i> Hoạt động gần nhất: 19/07/2025</p>
                                <p><i class="fa fa-users mr-2"></i> Vai trò: Quản lý bán hàng</p>
                            </div>
                        </div>
                        <a href="#" class="btn btn-primary mr-2" data-toggle="modal" data-target="#editProfileModal"><i class="fa fa-edit"></i> Chỉnh sửa hồ sơ</a>
                        <a href="history.html" class="btn btn-outline-secondary"><i class="fa fa-history"></i> Nhật ký hoạt động</a>
                    </div>
                </div>

                <!-- Recent Activity -->
                <div class="card shadow mb-4">
                    <div class="card-header bg-info text-white">
                        <i class="fa fa-history"></i> Hoạt động gần đây
                    </div>
                    <div class="card-body">
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item"><i class="fa fa-check text-success mr-2"></i> Đã xác nhận đơn hàng #12345</li>
                            <li class="list-group-item"><i class="fa fa-pencil text-primary mr-2"></i> Đã cập nhật sản phẩm "Tai nghe Bluetooth"</li>
                            <li class="list-group-item"><i class="fa fa-user-plus text-info mr-2"></i> Đã thêm khách hàng mới "Nguyễn Văn A"</li>
                            <li class="list-group-item"><i class="fa fa-star text-warning mr-2"></i> Đã phản hồi đánh giá khách hàng</li>
                            <li class="list-group-item"><i class="fa fa-envelope text-secondary mr-2"></i> Đã trả lời liên hệ từ "Lê Thị B"</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Profile Modal -->
    <div class="modal fade" id="editProfileModal" tabindex="-1" role="dialog" aria-labelledby="editProfileModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="editProfileModalLabel"><i class="fa fa-edit"></i> Chỉnh sửa hồ sơ admin</h5>
                    <button class="close text-white" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <form>
                    <div class="modal-body">
                        <div class="form-group text-center">
                            <img src="https://i.imgur.com/4M34hi2.png" class="rounded-circle mb-2" width="80" alt="Admin Avatar">
                            <input type="url" class="form-control" placeholder="URL ảnh đại diện" value="https://i.imgur.com/4M34hi2.png">
                        </div>
                        <div class="form-group">
                            <label>Họ và tên</label>
                            <input type="text" class="form-control" value="Rao Ahmed" required>
                        </div>
                        <div class="form-group">
                            <label>Email</label>
                            <input type="email" class="form-control" value="rao.ahmed@email.com" required>
                        </div>
                        <div class="form-group">
                            <label>Số điện thoại</label>
                            <input type="text" class="form-control" value="0123 456 789">
                        </div>
                        <div class="form-group">
                            <label>Địa chỉ</label>
                            <input type="text" class="form-control" value="Hà Nội, Việt Nam">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" type="button" data-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</main>
