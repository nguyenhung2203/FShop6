@model FShop6.Areas.Admin.Models.QuanLySanPhamModel

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/CustomerLayout.cshtml";
}


<table class="table table-bordered" width="100%" height="100%" cellspacing="0">
    <thead class="bg-light">
        <tr>
            <th>Mã SKU</th>
            <th>Loại biến thể</th>
            <th>Giá nhập</th>
            <th>Giá bán</th>
            <th>Số lượng</th>
            <th>Tình trạng</th>
            <th>Hình ảnh</th>
        </tr>
    </thead>
    <tbody>
		@foreach (var bt in Model.ChiTietSanPham)
		{

			<tr>
				<td>@bt.BienThes.MaSKU</td>
				<td>@bt.BienThes.LoaiBienThe</td>
				<td>@bt.BienThes.GiaNhap.ToString("N0")</td>
				<td>@bt.BienThes.GiaBan.ToString("N0")</td>
				<td>@bt.BienThes.SoLuongConLai</td>
				<td>@bt.BienThes.TinhTrang</td>
				<td>
					@foreach (var hinh in bt.dsAnh)
					{
						<img src="~/KhachHang/images/@hinh.URL" alt="Hình ảnh sản phẩm" style="width: 100px; height: 100px; object-fit: cover;" />
					}
				</td>
			</tr>

		}
    </tbody>
</table>

<a href="@Url.Action("QuanLySanPham", "QuanLySanPham", new { area = "Admin"})">
    <i class="fa fa-arrow-left"></i> Quay lại danh sách
</a>
