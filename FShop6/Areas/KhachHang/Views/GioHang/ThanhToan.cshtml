@{
    Layout = "~/Areas/KhachHang/Views/Shared/CustomerLayout.cshtml";
    ViewData["Title"] = "Thanh toán";
}
@model FShop6.Areas.KhachHang.Models.GioHangViewModel
<main class="main">
    <div class="checkout-wrapper">
        <!-- Left Column: Shipping & Payment -->
        <div class="left-column">
            <!-- Shipping Information Section -->
            <div class="shipping-container">
                <div class="shipping-header">
                    <h3 class="section-title">Thông Tin Vận Chuyển</h3>
                </div>
                <form id="checkout-form" class="shipping-form">
                    <div class="form-group">
                        <input type="text" id="fullName" placeholder="Họ và tên *" class="form-input" required />
                        <span class="form-error" id="fullName-error"></span>
                    </div>
                    <div class="form-group">
                        <input type="tel" id="phoneNumber" placeholder="Số điện thoại *" class="form-input" required />
                        <span class="form-error" id="phoneNumber-error"></span>
                    </div>
                    <div class="form-group">
                        <input type="text" id="address"
                               value="@Model.DiaChi.CuThe, @Model.DiaChi.Xa, @Model.DiaChi.Huyen, @Model.DiaChi.Tinh"
                               placeholder="Địa chỉ nhận hàng *" class="form-input" required />
                        <span class="form-error" id="address-error"></span>
                    </div>
                </form>
            </div>

            <!-- Payment Methods Section -->
            <div class="payment-container">
                <div class="payment-header">
                    <h3 class="section-title">Chọn Phương Thức Thanh Toán</h3>
                </div>
                <div class="payment-content">
                    <div class="payment-methods">
                        <label class="payment-method" for="cod">
                            <input type="radio" id="cod" name="payment" value="cod">
                            <span class="payment-icon">🚚</span>
                            <div class="payment-details">
                                <div class="payment-name">Thanh toán khi nhận hàng</div>
                                <div class="payment-desc">Thanh toán bằng tiền mặt khi nhận hàng</div>
                            </div>
                        </label>

                        <label class="payment-method" for="bank">
                            <input type="radio" id="bank" name="payment" value="bank">
                            <span class="payment-icon">🏦</span>
                            <div class="payment-details">
                                <div class="payment-name">Chuyển khoản ngân hàng</div>
                                <div class="payment-desc">Chuyển khoản qua tài khoản ngân hàng</div>
                            </div>
                        </label>
                    </div>

                    <button class="confirm-btn" id="confirmOrderBtn" >
                        Xác Nhận Đặt Hàng
                    </button>
                </div>
            </div>
        </div>

        <!-- Right Column: Order Summary -->
        <div class="right-column">
            <div class="order-container">
                <div class="order-header">
                    <h2>Đơn Hàng Của Bạn</h2>
                    <div class="order-divider"></div>
                </div>

                <table class="order__table">
                    <thead>
                        <tr>
                            <th style="width: 60px;">Ảnh</th>
                            <th style="width: 140px;">Tên sản phẩm</th>
                            <th style="width: 60px;">SL</th>
                            <th style="width: 80px;">Giá</th>
                        </tr>
                    </thead>
                </table>

                <div class="scroll-indicator" id="scrollIndicator">
                    ↓ Cuộn xuống để xem thêm sản phẩm ↓
                </div>

                <div class="products-container" id="productsContainer">
                    <table class="order__table">
                        <tbody>
                            @for(int i = 0; i < Model.GioHang.Count; i++)
                            {
	                            var sanPham = Model.GioHang[i];
                                <tr class="product-row">
                                    <td style="width: 60px; text-align: center;">
                                        <img src="@sanPham.HinhAnhDaiDien" alt="@sanPham.TenSanPham" class="order__img" />
                                    </td>
                                    <td style="width: 140px;">
                                        <h3 class="product-name">@sanPham.TenSanPham</h3>
                                        <span class="product-category">@sanPham.LoaiBienThe</span>
                                    </td>
                                    <td style="width: 60px; text-align: center;">
                                        <span class="table__quantity">@sanPham.SoLuong</span>
                                    </td>
                                    <td style="width: 80px; text-align: right;">
                                        <span class="table__price">@sanPham.GiaBan.ToString("N0")đ</span>
                                    </td>
                                </tr>
							}
                        </tbody>
                    </table>
                </div>

                <table class="order__table order-summary">
                    <tbody>
                        <tr class="summary-row">
                            <td colspan="3" style="text-align: right; padding-right: 15px;"><span class="order__subtitle">Tạm tính</span></td>
                            <td style="width: 80px; text-align: right;"><span class="table__price">8,900,000đ</span></td>
                        </tr>
                        <tr class="summary-row">
                            <td colspan="3" style="text-align: right; padding-right: 15px;"><span class="order__subtitle">Phí vận chuyển</span></td>
                            <td style="width: 80px; text-align: right;"><span>Miễn phí</span></td>
                        </tr>
                        <tr class="summary-row">
                            <td colspan="3" style="text-align: right; padding-right: 15px;"><span class="order__subtitle">Tổng cộng</span></td>
                            <td style="width: 80px; text-align: right;"><span class="order__grand-total">8,900,000đ</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Bank Transfer Modal -->
    <div id="bank-info-modal" class="modal-bank-info hidden">
        <div class="modal-bank-info__overlay"></div>
        <div class="modal-bank-info__content">
            <h4>Thông tin chuyển khoản</h4>
            <div class="modal-bank-info__details">
                <img src="https://images.unsplash.com/photo-1611974789855-9c2a0a7236a3?w=120&h=120&fit=crop" alt="QR chuyển khoản" class="modal-bank-info__qr">
                <div>
                    <p><strong>Ngân hàng:</strong> <span>TPBank</span></p>
                    <p><strong>Số tài khoản:</strong> <span>123456789</span></p>
                    <p><strong>Chủ tài khoản:</strong> <span>Nguyễn Văn A</span></p>
                    <p><strong>Nội dung:</strong> <span>SDT_Hoten</span></p>
                    <p><strong>Số tiền:</strong> <span>8,900,000đ</span></p>
                </div>
            </div>
            <button id="confirm-transfer-btn" class="btn">Tôi đã chuyển khoản</button>
        </div>
    </div>
</main>