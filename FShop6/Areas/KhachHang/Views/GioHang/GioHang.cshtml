@{
    Layout = "~/Areas/KhachHang/Views/Shared/CustomerLayout.cshtml";
    ViewData["Title"] = "Giỏ hàng";
}
@model FShop6.Areas.KhachHang.Models.GioHangViewModel

<main class="main">
    <section class="breadcrumb">
        <!-- breadcrumb -->
    </section>

    @using (Html.BeginForm("ThanhToan", "GioHang", FormMethod.Post, new { area = "KhachHang" }))
    {
        @Html.AntiForgeryToken()
        <section class="cart section--lg container">
            <div class="table__container">
                <table class="table">
                    <thead>
                        <tr>
                            <th>
                                <input type="checkbox" id="select-all" class="product-checkbox select-all-checkbox" />
                                <label for="select-all" class="checkbox-label">Chọn tất cả</label>
                            </th>
                            <th>Ảnh</th>
                            <th>Tên sản phẩm</th>
                            <th>Loại</th>
                            <th>Giá</th>
                            <th>Số lượng</th>
                            <th>Tổng tiền</th>
                            <th>Xoá</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.GioHang == null || Model.GioHang.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center">Chưa có sản phẩm trong giỏ hàng nào</td>
                            </tr>
                        }
                        else
                        {
                            @for (int i = 0; i < Model.GioHang.Count; i++)
                            {
                                var formId = "form-xoa-" + i;
                                var item = Model.GioHang[i];
                                <tr>
                                    <td>
                                        <input type="checkbox"
                                               name="GioHang[@i].DuocChon"
                                               value="true"
                                               @(item.DuocChon ? "checked" : "")
                                               class="item-checkbox product-checkbox"
                                               data-price="@(item.GiaBan* item.SoLuong)" />
                                        @Html.HiddenFor(m => m.GioHang[i].MaBienThe)
                                    </td>
                                    <td>
                                        <img src="@("/KhachHang/images/" + @item.HinhAnhDaiDien)" alt="@item.TenSanPham" class="table__img" />
                                        @Html.HiddenFor(m => m.GioHang[i].HinhAnhDaiDien)
                                    </td>
                                    <td>
                                        <h3 class="table__title">@item.TenSanPham</h3>
                                        @Html.HiddenFor(m => m.GioHang[i].TenSanPham)
                                    </td>
                                    <td>
                                        <span class="table__type">@item.LoaiBienThe</span>
                                        @Html.HiddenFor(m => m.GioHang[i].LoaiBienThe)
                                    </td>
                                    <td>
                                        <span class="table__price">@item.GiaBan.ToString("N0")</span>
                                        @Html.HiddenFor(m => m.GioHang[i].GiaBan)
                                    </td>
                                    <td>
                                        @Html.TextBoxFor(m => m.GioHang[i].SoLuong, new { @id = "quantity",  @class = "quantity", type = "number", min = "1", max = item.SoLuongTon })
                                    </td>
                                    <td>
                                        <span class="subtotal">@((item.GiaBan * item.SoLuong).ToString("N0"))</span>
                                    </td>
                                    <td>
                                        @using (Html.BeginForm("XoaGioHang", "GioHang", FormMethod.Post, new { area = "KhachHang", @class = "form-thong-bao" }))
                                        {
                                             @Html.HiddenFor(m => m.GioHang[i].MaBienThe)
                                            <button type="submit" data-confirm="Bạn có chắc chắn muốn xóa sản phẩm này?">
                                                <i class="fi fi-rs-trash table__trash"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
             <div class="pagination" style="margin-top: 0;">
                    @if (Model.TongSoTrang > 1)
                    {
                        <!-- Nút « -->
                        <li>
                            <a class="pagination__link icon @(Model.TrangHienTai == 1 ? "disabled" : "")"
                               href="@Url.Action("GioHang", "GioHang", 
                               new { area = "KhachHang", 
                                     trang = Model.TrangHienTai - 1})">
                                «
                            </a>
                        </li>

                        <!-- Các trang số -->
                        @for (int i = 1; i <= Model.TongSoTrang; i++)
                        {
                            <li>
                                <a class="pagination__link @(Model.TrangHienTai == i ? "active" : "")"
                                   href="@Url.Action("GioHang", "GioHang", 
                                   new { area = "KhachHang",      
                                         trang = i})">
                                    @i
                                </a>
                            </li>
                        }

                        <!-- Nút » -->
                        <li>
                            <a class="pagination__link icon @(Model.TrangHienTai == Model.TongSoTrang ? "disabled" : "")"
                               href="@Url.Action("GioHang", "GioHang", 
                               new { area = "KhachHang", 
                                     trang = Model.TrangHienTai + 1})">
                                »
                            </a>
                        </li>
                    }
                </div>
            <div class="cart__actions">
                <a href="@Url.Action("SanPham", "GioHang", new { area = "GioHang" })" class="btn flex btn__md">
                    <i class="fi-rs-shopping-bag"></i> Tiếp tục mua sắm
                </a>
            </div>

            <div class="divider"><i class="fi fi-rs-fingerprint"></i></div>

            <div class="cart__group grid">
                <div>
                    <div class="cart__shipping">
                        <h3 class="section__title">Địa chỉ giao hàng</h3>

                        <!-- Address Options -->
                        <div class="address-options">
                            <div class="address-option">
                                <input type="radio" id="existing-address" name="address-type" value="existing" checked />
                                <label for="existing-address">Chọn địa chỉ có sẵn</label>
                            </div>
                            <div class="address-option">
                                <input type="radio" id="new-address" name="address-type" value="new" />
                                <label for="new-address">Nhập địa chỉ mới</label>
                            </div>
                        </div>

                        <!-- Existing Address Container -->
                        <div class="existing-address-container hidden" id="existing-address-container">
                            <input type="text" class="form__input" style="opacity:1;pointer-events:none" name="@Model.DiaChiMacDinh" value="@Model.DiaChiMacDinh" placeholder="Số nhà, tên đường..." />
                        </div>

                        <!-- New Address Container -->
                        <div class="new-address-container" id="new-address-container">
                            <div class="form grid">
                                <!-- Select để hiển thị, value sẽ là tên -->
                                <select class="form__input" name="DiaChi.Tinh" id="city-province">
                                    <option value="" disabled selected>Chọn Tỉnh/Thành phố</option>
                                </select>

                                <select class="form__input" name="DiaChi.Huyen" id="district">
                                    <option value="" disabled selected>Chọn Quận/Huyện</option>
                                </select>

                                <select class="form__input" name="DiaChi.Xa" id="ward">
                                    <option value="" disabled selected>Chọn Phường/Xã</option>
                                </select>

                                <input type="text" id="diachi" class="form__input" name="DiaChi.CuThe" placeholder="Số nhà, tên đường..." />
                                <p id="thongbao" style="display: none"></p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="cart__total">
                    <h3 class="section__title">Thanh toán</h3>
                    <table class="cart__total-table">
                        <tr>
                            <td><span class="cart__total-title">Tổng tạm tính</span></td>
                            <td><span class="cart__total-price" id="selected-total">0₫</span></td>
                        </tr>
                        <tr>
                            <td><span class="cart__total-title">Phí giao hàng</span></td>
                            <td><span class="cart__total-price">Miễn phí vận chuyển</span></td>
                        </tr>
                        <tr>
                            <td><span class="cart__total-title">Tổng tiền</span></td>
                            <td><span class="cart__total-price" id="grand-total">0₫</span></td>
                        </tr>
                    </table>
                    <button type="submit" class="btn flex btn--md" id="checkout-btn">
                        <i class="fi fi-rs-box-alt"></i> Thanh toán (<span id="selected-count">0</span> sản phẩm)
                    </button>
                </div>
            </div>
        </section>
    }
</main>

<script>
    document.querySelector("form").addEventListener("keydown", function (e) {
    if (e.key === "Enter" && e.target.id !== "checkout-btn") {
        e.preventDefault(); // chặn submit khi nhấn Enter trong input
    }
});

    document.addEventListener('DOMContentLoaded', function() {
        // Cart functionality
        const selectAllCheckbox = document.getElementById('select-all');
        // Chỉ lấy checkbox chính, không lấy hidden input của CheckBoxFor
        const itemCheckboxes = document.querySelectorAll('.item-checkbox[type="checkbox"]');
        const selectedTotal = document.getElementById('selected-total');
        const grandTotal = document.getElementById('grand-total');
        const selectedCount = document.getElementById('selected-count');
        const checkoutBtn = document.getElementById('checkout-btn');

        // Address functionality
        const existingAddressRadio = document.getElementById('existing-address');
        const newAddressRadio = document.getElementById('new-address');
        const existingAddressContainer = document.getElementById('existing-address-container');
        const newAddressContainer = document.getElementById('new-address-container');
        const soLuongMua = parseInt(document.getElementById('quantity').value);
        const maxSoLuong = parseInt(document.getElementById('quantity').max);

        const shippingFee = 0;

        const diachi = document.getElementById('diachi');
        const diachiRegex = /^[\p{L}0-9\s,\.]{1,200}$/u;
        const thongbao = document.getElementById('thongbao');      
        // Function to format currency
        function formatCurrency(amount) {
            return amount.toLocaleString('vi-VN') + '₫';
        }

        // Function to update totals
        function updateTotals() {
            let total = 0;
            let count = 0;

            itemCheckboxes.forEach(checkbox => {
                if (checkbox.checked) {
                    total += parseFloat(checkbox.dataset.price || 0);
                    count++;
                }
            });

            selectedTotal.textContent = formatCurrency(total);
            grandTotal.textContent = formatCurrency(total + (count > 0 ? shippingFee : 0));
            selectedCount.textContent = count;

            if (count > 0) {
                checkoutBtn.style.opacity = '1';
                checkoutBtn.style.pointerEvents = 'auto';
           diachi.addEventListener('input', function () {
        // Chỉ kiểm tra khi có ký tự
        if (diachi.value.trim().length > 0) {
            if (!diachiRegex.test(diachi.value)) {
                thongbao.style.display = 'block';
                thongbao.textContent = 'Địa chỉ không hợp lệ hoặc quá 200 ký tự';
                thongbao.style.color = 'red';
                diachi.style.borderColor = 'red';
                checkoutBtn.style.opacity = '0.6';
                checkoutBtn.style.pointerEvents = 'none';
            } else {
                thongbao.style.display = 'none';
                diachi.style.borderColor = '';
                 checkoutBtn.style.opacity = '1';
                checkoutBtn.style.pointerEvents = 'auto';
            }
        } else {
            thongbao.textContent = 'Vui lòng nhập địa chỉ giao hàng';
            thongbao.style.color = 'red';
            thongbao.style.display = 'none';
            diachi.style.borderColor = '';
            checkoutBtn.style.opacity = '0.6';
            checkoutBtn.style.pointerEvents = 'none';
        }
        });
            } else {
                checkoutBtn.style.opacity = '0.6';
                checkoutBtn.style.pointerEvents = 'none';
            }
        }

        // Address type switching function
        function toggleAddressContainer() {
            if (existingAddressRadio.checked) {
                existingAddressContainer.classList.remove('hidden');
                newAddressContainer.classList.add('hidden');

                // Clear new address form when switching to existing
                const newAddressInputs = newAddressContainer.querySelectorAll('select, input');
                newAddressInputs.forEach(input => {
                    if (input.tagName === 'SELECT') {
                        input.selectedIndex = 0;
                    } else {
                        input.value = '';
                    }
                });
            } else if (newAddressRadio.checked) {
                newAddressContainer.classList.remove('hidden');
                existingAddressContainer.classList.add('hidden');

                // Clear existing address selection when switching to new
                const existingSelect = existingAddressContainer.querySelector('select');
                if (existingSelect) {
                    existingSelect.selectedIndex = 0;
                }
            }
        }

        // Event listeners for address type switching
        if (existingAddressRadio && newAddressRadio) {
            existingAddressRadio.addEventListener('change', toggleAddressContainer);
            newAddressRadio.addEventListener('change', toggleAddressContainer);

            // Initialize address containers
            toggleAddressContainer();
        }

        // Set default checked state for all items
        itemCheckboxes.forEach(checkbox => {
            checkbox.checked = false; // Mặc định tất cả đều được tick
        });
        selectAllCheckbox.checked = false; // Select all cũng được tick

        // Select all functionality
        selectAllCheckbox.addEventListener('change', function() {
            itemCheckboxes.forEach(checkbox => {
                checkbox.checked = this.checked;
            });
            updateTotals();
        });

        // Individual checkbox functionality
        itemCheckboxes.forEach(checkbox => {
            checkbox.addEventListener('change', function() {
                // Update select all checkbox state
                const checkedCount = document.querySelectorAll('.item-checkbox[type="checkbox"]:checked').length;
                selectAllCheckbox.checked = checkedCount === itemCheckboxes.length;
                selectAllCheckbox.indeterminate = checkedCount > 0 && checkedCount < itemCheckboxes.length;

                updateTotals();
            });
        });

        // Quantity change functionality
        const quantityInputs = document.querySelectorAll('.quantity');
        quantityInputs.forEach((input, index) => {
            input.addEventListener('change', function() {
                const checkbox = itemCheckboxes[index];
                if (checkbox) {
                    // Get base price from original data-price divided by original quantity
                    const row = this.closest('tr');
                    const priceText = row.querySelector('.table__price').textContent.replace(/[,₫]/g, '');
                    const basePrice = parseFloat(priceText);
                    const newQuantity = parseInt(this.value) || 1;
                    const newTotal = basePrice * newQuantity;

                    // Update checkbox data-price
                    checkbox.dataset.price = newTotal;

                    // Update subtotal display
                    const subtotalSpan = row.querySelector('.subtotal');
                    if (subtotalSpan) {
                        subtotalSpan.textContent = newTotal.toLocaleString('vi-VN');
                    }

                    // Update totals if this item is checked
                    if (checkbox.checked) {
                        updateTotals();
                    }
                }
            });
        });

        // Initialize totals after setting default checked state
        updateTotals();
    });
</script>