@{
    Layout = "~/Areas/KhachHang/Views/Shared/CustomerLayout.cshtml";
    ViewData["Title"] = "Giỏ hàng";
}
@model List<FShop6.Areas.KhachHang.Models.GioHangModel>
<main class="main">
    <section class="breadcrumb">
        <ul class="breadcrumb__list flex container">
            <li><a asp-controller="Home" asp-action="Index" class="breadcrumb__link">Trang chủ</a></li>
            <li><span class="breadcrumb__link">></span></li>
            <li><span class="breadcrumb__link">Sản phẩm</span></li>
            <li><span class="breadcrumb__link">></span></li>
            <li><span class="breadcrumb__link">Giỏ hàng</span></li>
        </ul>
    </section>

    <section class="cart section--lg container">
        <div class="table__container">
            <table class="table">
                <thead>
                    <tr>
                        <th>
                            <input type="checkbox" id="select-all" class="product-checkbox select-all-checkbox" />
                            <label for="select-all" class="checkbox-label">Chọn tất cả</label>
                        </th>
                        <th>Ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Loại</th>
                        <th>Giá</th>
                        <th>Số lượng</th>
                        <th>Tổng tiền</th>
                        <th>Xoá</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var item = Model[i];
                        var bienThe = item.BienThe;
                        var sanPham = bienThe?.SanPham;
                        var price = bienThe?.GiaBan ?? 0;
                        var subtotal = price * item.SoLuong;
                        string checkboxId = $"product-{i}";
                        <tr>
                            <td>
                                <input type="checkbox" id="@checkboxId" class="product-checkbox item-checkbox"
                                       data-price="@subtotal" />
                                <label for="@checkboxId" class="checkbox-label"></label>
                            </td>
                            <td>
                                <img src="@sanPham?.HinhAnhDaiDien" alt="@sanPham?.TenSanPham" class="table__img" />
                            </td>
                            <td>
                                <h3 class="table__title">@sanPham?.TenSanPham</h3>
                                <p class="table__description">@sanPham?.MoTa</p>
                            </td>
                            <td>@bienThe?.TenBienThe</td>
                            <td><span class="table__price">@price.ToString("N0") ₫</span></td>
                            <td>
                                <input type="number" value="@item.SoLuong" class="quantity" min="1" />
                            </td>
                            <td><span class="subtotal">@subtotal.ToString("N0") ₫</span></td>
                            <td>
                                <form asp-action="Xoa" asp-route-id="@item.Id" method="post">
                                    <button type="submit" class="btn table__trash"><i class="fi fi-rs-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>

        <div class="cart__actions">
            <a href="#" class="btn flex btn__md"><i class="fi-rs-shuffle"></i> Sắp xếp giỏ hàng</a>
            <a asp-controller="Shop" asp-action="Index" class="btn flex btn__md">
                <i class="fi-rs-shopping-bag"></i> Tiếp tục mua sắm
            </a>
        </div>

        <div class="divider"><i class="fi fi-rs-fingerprint"></i></div>

        <div class="cart__group grid">
            <div>
                <div class="cart__shipping">
                    <h3 class="section__title">Địa chỉ giao hàng</h3>
                    <form id="shipping-form" class="form grid">
                        <select class="form__input" id="city-province"><option>Chọn Tỉnh/Thành phố</option></select>
                        <select class="form__input" id="district"><option>Chọn Quận/Huyện</option></select>
                        <select class="form__input" id="ward"><option>Chọn Phường/Xã</option></select>
                        <input type="text" class="form__input" placeholder="Số nhà, tên đường..." />
                        <div class="form__btn">
                            <button type="submit" class="btn flex btn--sm">
                                <i class="fi-rs-shuffle"></i> Cập nhật
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="cart__total">
                <h3 class="section__title">Thanh toán</h3>
                @{
                    // var total = Model.Sum(x => x.x);
                    var shipping = 0;
                    // var grandTotal = total + shipping;
                }
                <table class="cart__total-table">
                    <tr>
                        <td><span class="cart__total-title">Tổng tạm tính</span></td>
                        <td><span class="cart__total-price" id="selected-total">0₫</span></td>
                    </tr>
                    <tr>
                        <td><span class="cart__total-title">Phí giao hàng</span></td>
                        <td><span class="cart__total-price">Miễn phí vận chuyển</span></td>
                    </tr>
                    <tr>
                        <td><span class="cart__total-title">Tổng tiền</span></td>
                        <td><span class="cart__total-price" id="grand-total">@shipping.ToString("C")</span></td>
                    </tr>
                </table>
                <a href="@Url.Action("ThanhToan", "GioHang", new { area = "KhachHang" })" class="btn flex btn--md" id="checkout-btn">
                    <i class="fi fi-rs-box-alt"></i> Thanh toán (<span id="selected-count">0</span> sản phẩm)
                </a>
            </div>
        </div>
    </section>
</main>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const selectAllCheckbox = document.getElementById('select-all');
        const itemCheckboxes = document.querySelectorAll('.item-checkbox');
        const selectedTotal = document.getElementById('selected-total');
        const grandTotal = document.getElementById('grand-total');
        const selectedCount = document.getElementById('selected-count');
        const checkoutBtn = document.getElementById('checkout-btn');

        const shippingFee = 10000; // 10,000 VND

        // Function to format currency
        function formatCurrency(amount) {
            return amount.toLocaleString('vi-VN') + '₫';
        }

        // Function to update totals
        function updateTotals() {
            let total = 0;
            let count = 0;

            itemCheckboxes.forEach(checkbox => {
                if (checkbox.checked) {
                    total += parseFloat(checkbox.dataset.price || 0);
                    count++;
                }
            });

            selectedTotal.textContent = formatCurrency(total);
            grandTotal.textContent = formatCurrency(total + (count > 0 ? shippingFee : 0));
            selectedCount.textContent = count;

            // Update checkout button state
            if (count > 0) {
                checkoutBtn.style.opacity = '1';
                checkoutBtn.style.pointerEvents = 'auto';
            } else {
                checkoutBtn.style.opacity = '0.6';
                checkoutBtn.style.pointerEvents = 'none';
            }
        }

        // Select all functionality
        selectAllCheckbox.addEventListener('change', function() {
            itemCheckboxes.forEach(checkbox => {
                checkbox.checked = this.checked;
            });
            updateTotals();
        });

        // Individual checkbox functionality
        itemCheckboxes.forEach(checkbox => {
            checkbox.addEventListener('change', function() {
                // Update select all checkbox state
                const checkedCount = document.querySelectorAll('.item-checkbox:checked').length;
                selectAllCheckbox.checked = checkedCount === itemCheckboxes.length;
                selectAllCheckbox.indeterminate = checkedCount > 0 && checkedCount < itemCheckboxes.length;

                updateTotals();
            });
        });

        // Initialize
        updateTotals();
    });
</script>