@{
    Layout = "~/Areas/KhachHang/Views/Shared/CustomerLayout.cshtml";
    ViewData["Title"] = "Giỏ hàng";
}
<main class="main">
    <section class="breadcrumb">
        <ul class="breadcrumb__list flex container">
            <li><a asp-controller="Home" asp-action="Index" class="breadcrumb__link">Trang chủ</a></li>
            <li><span class="breadcrumb__link">></span></li>
            <li><span class="breadcrumb__link">Sản phẩm</span></li>
            <li><span class="breadcrumb__link">></span></li>
            <li><span class="breadcrumb__link">Giỏ hàng</span></li>
        </ul>
    </section>

    <section class="cart section--lg container">
        <div class="table__container">
            <table class="table">
                <thead>
                    <tr>
                        <th>Ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Giá</th>
                        <th>Số lượng</th>
                        <th>Tổng tiền</th>
                        <th>Xoá</th>
                    </tr>
                </thead>
                <tbody>
                    @* @foreach (var item in Model)
                    {
                        <tr>
                            <td><img src="@item.ImageUrl" alt="" class="table__img" /></td>
                            <td>
                                <h3 class="table__title">@item.ProductName</h3>
                                <p class="table__description">@item.Description</p>
                            </td>
                            <td><span class="table__price">@item.Price.ToString("C")</span></td>
                            <td><input type="number" value="@item.Quantity" class="quantity" /></td>
                            <td><span class="subtotal">@item.Subtotal.ToString("C")</span></td>
                            <td><i class="fi fi-rs-trash table__trash"></i></td>
                        </tr>
                    } *@
                    <tr>
                        <td><img src="ImageUrl" alt="" class="table__img" /></td>
                        <td>
                            <h3 class="table__title">ProductName</h3>
                            <p class="table__description">Description</p>
                        </td>
                        <td><span class="table__price">Price.ToString("C")</span></td>
                        <td><input type="number" value="Quantity" class="quantity" /></td>
                        <td><span class="subtotal">Subtotal.ToString("C")</span></td>
                        <td><i class="fi fi-rs-trash table__trash"></i></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="cart__actions">
            <a href="#" class="btn flex btn__md"><i class="fi-rs-shuffle"></i> Sắp xếp giỏ hàng</a>
            <a asp-controller="Shop" asp-action="Index" class="btn flex btn__md">
                <i class="fi-rs-shopping-bag"></i> Tiếp tục mua sắm
            </a>
        </div>

        <div class="divider"><i class="fi fi-rs-fingerprint"></i></div>

        <div class="cart__group grid">
            <div>
                <div class="cart__shipping">
                    <h3 class="section__title">Địa chỉ giao hàng</h3>
                    <form id="shipping-form" class="form grid">
                        <select class="form__input" id="city-province"><option>Chọn Tỉnh/Thành phố</option></select>
                        <select class="form__input" id="district"><option>Chọn Quận/Huyện</option></select>
                        <select class="form__input" id="ward"><option>Chọn Phường/Xã</option></select>
                        <input type="text" class="form__input" placeholder="Số nhà, tên đường..." />
                        <div class="form__btn">
                            <button type="submit" class="btn flex btn--sm">
                                <i class="fi-rs-shuffle"></i> Cập nhật
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="cart__total">
                <h3 class="section__title">Thanh toán</h3>
                @{
                    // var total = Model.Sum(x => x.x);
                    var shipping = 10.00m;
                    // var grandTotal = total + shipping;
                }
                <table class="cart__total-table">
                    <tr>
                        <td><span class="cart__total-title">Tổng tạm tính</span></td>
                        @* <td><span class="cart__total-price">@total.ToString("C")</span></td> *@
                    </tr>
                    <tr>
                        <td><span class="cart__total-title">Phí giao hàng</span></td>
                        <td><span class="cart__total-price">@shipping.ToString("C")</span></td>
                    </tr>
                    <tr>
                        <td><span class="cart__total-title">Tổng tiền</span></td>
                        @* <td><span class="cart__total-price">@grandTotal.ToString("C")</span></td> *@
                    </tr>
                </table>
                <a asp-controller="Cart" asp-action="Checkout" class="btn flex btn--md">
                    <i class="fi fi-rs-box-alt"></i> Thanh toán
                </a>
            </div>
        </div>
    </section>
</main>