@model List<FShop6.Areas.KhachHang.Models.TinTucModel>

@{
    Layout = "~/Areas/KhachHang/Views/Shared/CustomerLayout.cshtml";
    ViewData["Title"] = "Tin tức";
}

<main class="main">
    <section class="breadcrumb">
        <ul class="breadcrumb__list flex container">
            <li><a href="/" class="breadcrumb__link">Trang chủ</a></li>
            <li><span class="breadcrumb__link">></span></li>
            <li><span class="breadcrumb__link">Tin tức</span></li>
        </ul>
    </section>

    <section class="news-page container section--lg">
        <div class="news-page__container grid">
            <div class="news-page__main">
                @if (Model != null && Model.Count > 0)
                {
                    var baiNoiBat = Model.First();
                    <div class="featured-post">
                        <a href="/KhachHang/TinTuc/ChiTietTinTuc/@baiNoiBat.MaTinTuc" class="featured-post__image">
                            <img src="@baiNoiBat.HinhAnhDaiDien" alt="@baiNoiBat.TieuDe" />
                        </a>
                        <div class="featured-post__content">
                            <a href="/KhachHang/TinTuc/ChiTietTinTuc/@baiNoiBat.MaTinTuc"><h2 class="featured-post__title">@baiNoiBat.TieuDe</h2></a>
                            <p class="featured-post__description">@baiNoiBat.MoTaNgan</p>
                            <div class="author-info">
                                <span>Đăng bởi <strong>Admin</strong></span> |
                                <span>@baiNoiBat.ThoiGianTao.ToString("dd/MM/yyyy")</span>
                            </div>
                        </div>
                    </div>

                    <div class="post-list">
                        @foreach (var tin in Model.Skip(1))
                        {
                            <div class="post-card">
                                <a href="@Url.Action("ChiTietTinTuc", "TinTuc", new {area = "KhachHang", id = tin.MaTinTuc})" class="post-card__image">
                                    <img src="@tin.HinhAnhDaiDien" alt="@tin.TieuDe" />
                                </a>
                                <div class="post-card__content">
                                    <span class="product__category">Tin tức</span>
                                    <a href="/KhachHang/TinTuc/ChiTietTinTuc/@tin.MaTinTuc">
                                        <h3 class="post-card__title">@tin.TieuDe</h3>
                                    </a>
                                    <div class="author-info">
                                        <span>Đăng bởi <strong>Admin</strong></span> |
                                        <span>@tin.ThoiGianTao.ToString("dd/MM/yyyy")</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p>Hiện chưa có bài viết nào.</p>
                }
            </div>

            <aside class="news-page__sidebar">
                <div class="sidebar__widget">
                    <h4 class="widget__title">Bài viết gần đây</h4>
                    <ul class="widget__list recent-posts">
                        @foreach (var bai in Model.Take(5))
                        {
                            <li>
                                <a href="/KhachHang/TinTuc/ChiTietTinTuc/@bai.MaTinTuc">@bai.TieuDe</a>
                            </li>
                        }
                    </ul>
                </div>
            </aside>
        </div>
    </section>
</main>