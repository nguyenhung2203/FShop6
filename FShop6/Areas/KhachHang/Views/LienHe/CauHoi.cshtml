@{
    Layout = "~/Areas/KhachHang/Views/Shared/CustomerLayout.cshtml";
    ViewData["Title"] = "Câu Hỏi Thường Gặp";
}
<main class="main">
    <section class="breadcrumb">
        <ul class="breadcrumb__list flex container">
            <li><a href="index.html" class="breadcrumb__link">Home</a></li>
            <li><span class="breadcrumb__link">></span></li>
            <li><span class="breadcrumb__link">FAQ</span></li>
        </ul>
    </section>

    <section class="policy-page container section--lg">
        <h1 class="policy-page__title">Câu Hỏi Thường Gặp (FAQ)</h1>

        <div class="faq__container">
            <details class="faq__item">
                <summary class="faq__question">Làm thế nào để đặt hàng?</summary>
                <div class="faq__answer">
                    <p>Bạn có thể đặt hàng trực tiếp trên website bằng cách thêm sản phẩm vào giỏ hàng và tiến hành thanh toán. Hoặc bạn cũng có thể nhắn tin trực tiếp cho Fanpage FShop6 để được hỗ trợ đặt hàng.</p>
                </div>
            </details>

            <details class="faq__item">
                <summary class="faq__question">Shop có giao hàng đến tỉnh của tôi không?</summary>
                <div class="faq__answer">
                    <p>Có. Chúng tôi hỗ trợ giao hàng toàn quốc. Thời gian giao hàng dự kiến từ 3-5 ngày làm việc tùy thuộc vào địa chỉ của bạn.</p>
                </div>
            </details>

            <details class="faq__item">
                <summary class="faq__question">Làm sao để chọn đúng size áo?</summary>
                <div class="faq__answer">
                    <p>Chúng tôi có cung cấp bảng size chi tiết trong phần mô tả của mỗi sản phẩm quần áo. Bạn vui lòng đối chiếu số đo của mình với bảng size để chọn được kích thước phù hợp nhất nhé.</p>
                </div>
            </details>

            <details class="faq__item">
                <summary class="faq__question">Tôi có thể thanh toán bằng những hình thức nào?</summary>
                <div class="faq__answer">
                    <p>Hiện tại, chúng tôi hỗ trợ hai hình thức thanh toán chính: Thanh toán khi nhận hàng (COD) và Chuyển khoản ngân hàng.</p>
                </div>
            </details>
        </div>
    </section>
</main>
