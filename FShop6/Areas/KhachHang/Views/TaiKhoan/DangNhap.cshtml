<main class="main">
    <section class="login-register section--lg">
        <div class="login-register__container container">
            <div class="login">
                <h3 class="section__title">Chào mừng trở lại!</h3>

                <form action="" class="form grid">
                    <input type="email" placeholder="Email của bạn" class="form__input" />
                    <input type="password" placeholder="Mật khẩu" class="form__input" />
                    <a href="forgot-password.html" class="form__forgot">Quên mật khẩu?</a>
                    <div class="form__btn">
                        <button class="btn">Đăng Nhập</button>
                    </div>
                </form>
                <p class="form__switch">Chưa có tài khoản? <a href="register.html">Đăng ký tại đây</a></p>
            </div>
        </div>
    </section>
</main>