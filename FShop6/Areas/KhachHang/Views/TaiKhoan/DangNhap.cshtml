@model FShop6.Areas.KhachHang.Models.DangNhapViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng Nhập - FShop6</title>
    <link rel="stylesheet" href="https://cdn-uicons.flaticon.com/2.0.0/uicons-brands/css/uicons-brands.css" />
    <link rel="stylesheet" href="~/KhachHang/css/styles.css" />
</head>
<body>
    <main class="main">
        <section class="login-register section--lg">
            <div class="login-register__container container">
                <div class="login header-minimal">
                    <div class="container">
                        <a href="@Url.Action("Index", "TrangChu", new { area = "KhachHang" })" class="logo">
                            <img src="~/KhachHang/images/logo.png" alt="FShop Logo" />
                        </a>
                    </div>
                    <h3 class="section__title">Chào mừng trở lại!</h3>

                    @* Form dùng model binding *@
                    <form asp-action="DangNhap" method="post" class="form grid">
                        <input name="ThongTinDangNhap" placeholder="Email / Số điện thoại / Tài khoản" class="form__input_log form__input" />
                        <span asp-validation-for="ThongTinDangNhap" class="text-danger"></span>

                        <div class="form__input-group" style="position: relative;">
                            <input name="MatKhau" id="passwordInput" placeholder="Mật khẩu" class="form__input_log form__input" type="password" />
                            <span asp-validation-for="MatKhau" class="text-danger"></span>
                            <button type="button"
                                    onclick="togglePassword()"
                                    title="Hiện/Ẩn mật khẩu"
                                    style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer;">
                                👁
                            </button>
                        </div>

                        <a href="@Url.Action("QuenMatKhau", "TaiKhoan", new { area = "KhachHang" })" class="form__forgot">Quên mật khẩu?</a>

                        <div class="form__btn">
                            <button type="submit" class="btn">Đăng Nhập</button>
                        </div>

                        <div class="text-danger mt-2">
                            @ViewBag.ThongBao
                        </div>
                    </form>

                    <p class="form__switch">
                        Chưa có tài khoản? <a href="@Url.Action("DangKy", "TaiKhoan", new { area = "KhachHang" })">Đăng ký tại đây</a>
                    </p>
                </div>
            </div>
        </section>
    </main>

    <script>
        function togglePassword() {
            var input = document.getElementById("passwordInput");
            input.type = input.type === "password" ? "text" : "password";
        }
    </script>

</body>
</html>
