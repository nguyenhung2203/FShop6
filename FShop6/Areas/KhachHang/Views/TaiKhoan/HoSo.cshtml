@{
    Layout = "~/Areas/KhachHang/Views/Shared/CustomerLayout.cshtml";
    ViewData["Title"] = "Tài khoản";
}
<main class="main">
    <!--=============== BREADCRUMB ===============-->
    <section class="breadcrumb">
        <ul class="breadcrumb__list flex container">
            <li><a href="index.html" class="breadcrumb__link">Trang chủ</a></li>
            <li><span class="breadcrumb__link">></span></li>
            <li><span class="breadcrumb__link">Tài khoản</span></li>
        </ul>
    </section>

    <!--=============== ACCOUNTS ===============-->
    <section class="accounts section--lg">
        <div class="accounts__container container grid">
            <div class="account__tabs">
                <p class="account__tab active-tab" data-target="#dashboard">
                    <i class="fi fi-rs-settings-sliders"></i> Bảng điều khiển
                </p>
                <p class="account__tab" data-target="#orders">
                    <i class="fi fi-rs-shopping-bag"></i> Đơn hàng
                </p>
                <p class="account__tab" data-target="#update-profile">
                    <i class="fi fi-rs-user"></i> Cập nhật hồ sơ
                </p>
                <p class="account__tab" data-target="#address">
                    <i class="fi fi-rs-marker"></i> Địa chỉ của tôi
                </p>
                <p class="account__tab" data-target="#change-password">
                    <i class="fi fi-rs-settings-sliders"></i> Đổi mật khẩu
                </p>
            </div>
            <div class="tabs__content">
                <div class="tab__content active-tab" content id="dashboard">
                    <h3 class="tab__header">Xin chào Rosie</h3>
                    <div class="tab__body">
                        <p class="tab__description">
                            Từ bảng điều khiển tài khoản, bạn có thể dễ dàng kiểm tra & xem đơn hàng gần đây, quản lý địa chỉ giao hàng và thanh toán, chỉnh sửa mật khẩu và thông tin tài khoản.
                        </p>
                    </div>
                </div>
                <div class="tab__content" content id="orders">
                    <h3 class="tab__header">Đơn hàng của bạn</h3>
                    <div class="tab__body">
                        <table class="placed__order-table">
                            <thead>
                                <tr>
                                    <th>Mã đơn</th>
                                    <th>Ngày đặt</th>
                                    <th>Trạng thái</th>
                                    <th>Tổng tiền</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>#1357</td>
                                    <td>19/03/2022</td>
                                    <td>Đang xử lý</td>
                                    <td>125.000đ</td>
                                    <td>
                                        <button class="btn-cancel-order" data-order="#1357">Hủy</button>
                                    </td>
                                </tr>
                                <tr>
                                    <td>#2468</td>
                                    <td>29/06/2022</td>
                                    <td>Hoàn thành</td>
                                    <td>364.000đ</td>
                                    <td>
                                        <a href="#" class="view__order">Xem</a>
                                    </td>
                                </tr>
                                <tr>
                                    <td>#2366</td>
                                    <td>02/08/2022</td>
                                    <td>Hoàn thành</td>
                                    <td>280.000đ</td>
                                    <td>
                                        <a href="#" class="view__order">Xem</a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="tab__content" content id="update-profile">
                    <h3 class="tab__header">Cập nhật hồ sơ</h3>
                    <div class="tab__body">
                        <form class="form grid" id="profile-form">
                            <input type="text"
                                   placeholder="Tên đăng nhập"
                                   class="form__input"
                                   name="username" />
                            <input type="text"
                                   placeholder="Họ và tên"
                                   class="form__input"
                                   name="fullname" />
                            <input type="email"
                                   placeholder="Email"
                                   class="form__input"
                                   name="email" />
                            <input type="text"
                                   placeholder="Số điện thoại"
                                   class="form__input"
                                   name="phone" />
                            <div class="form__btn">
                                <button class="btn btn--md" type="submit">Lưu</button>
                            </div>
                        </form>
                    </div>
                </div>
                <div class="tab__content" content id="address">
                    <h3 class="tab__header">Địa chỉ giao hàng</h3>
                    <div class="tab__body">
                        <div id="address-view">
                            <address class="address">
                                3522 Interstate <br />
                                75 Business Spur, <br />
                                Sault Ste. <br />
                                Marie, Mi 49783
                            </address>
                            <p class="city">New York</p>
                            <a href="#" class="edit" id="edit-address-btn">Chỉnh sửa</a>
                        </div>
                        <form class="form grid" id="address-form" style="display:none;">
                            <input type="text"
                                   placeholder="Địa chỉ"
                                   class="form__input"
                                   name="address" />
                            <input type="text"
                                   placeholder="Thành phố"
                                   class="form__input"
                                   name="city" />
                            <input type="text"
                                   placeholder="Tỉnh/Quận"
                                   class="form__input"
                                   name="state" />
                            <input type="text"
                                   placeholder="Mã bưu điện"
                                   class="form__input"
                                   name="zipcode" />
                            <div class="form__btn">
                                <button class="btn btn--md" type="submit">Lưu</button>
                                <button class="btn btn--md" type="button" id="cancel-edit-address">Hủy</button>
                            </div>
                        </form>
                    </div>
                </div>
                <div class="tab__content" content id="change-password">
                    <h3 class="tab__header">Đổi mật khẩu</h3>
                    <div class="tab__body">
                        <form class="form grid">
                            <input type="password"
                                   placeholder="Mật khẩu hiện tại"
                                   class="form__input" />
                            <input type="password"
                                   placeholder="Mật khẩu mới"
                                   class="form__input" />
                            <input type="password"
                                   placeholder="Xác nhận mật khẩu"
                                   class="form__input" />
                            <div class="form__btn">
                                <button class="btn btn--md">Lưu</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>