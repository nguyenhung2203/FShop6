@{
    Layout = "~/Areas/KhachHang/Views/Shared/CustomerLayout.cshtml";
    ViewData["Title"] = "Sản phẩm";
}
}
@model FShop6.Areas.KhachHang.Models.PhanTrangSanPhamViewModel
<main class="main">
    <section class="breadcrumb">
        <ul class="breadcrumb__list flex container">
            <li><a href="index.html" class="breadcrumb__link">Trang chủ</a></li>
            <li><span class="breadcrumb__link">></span></li>
            <li><span class="breadcrumb__link">Sản phẩm</span></li>
        </ul>
    </section>

    <section class="shop-page container section--lg">
        <div class="shop__container">
            <aside class="shop__sidebar">
                <div class="sidebar__widget">
                    <h3 class="widget__title">Danh Mục</h3>
                    <ul class="widget__content filter__list" id="category-filter">
                        @if (Model?.DanhSachDanhMuc != null)
                        {
                            foreach (var dm in Model.DanhSachDanhMuc)
                            {
                                // Kiểm tra nếu danh mục hiện tại đang được lọc
                                var isChecked = ViewBag.MaDanhMuc != null && (int)ViewBag.MaDanhMuc == dm.Id;

                                <li>
                                    <label>
                                        <input type="checkbox"
                                               class="category-checkbox product-checkbox"
                                               value="@dm.Id"
                                               data-id="@dm.Id"
                                               @(isChecked ? "checked" : "") />
                                        @dm.TenDanhMuc
                                    </label>
                                </li>
                            }
                        }
                        else
                        {
                            <p>Không có danh mục nào.</p>
                        }

                        @section Scripts {
                            <script>
                                document.addEventListener('DOMContentLoaded', function () {
                                    const checkboxes = document.querySelectorAll('.category-checkbox');

                                    checkboxes.forEach(cb => {
                                        cb.addEventListener('change', function () {
                                            const maDanhMuc = this.dataset.id;
                                            const isChecked = this.checked;

                                            let url = '@Url.Action("SanPham", "CuaHang", new { area = "KhachHang" })';

                                            if (isChecked) {
                                                // Đang chọn → lọc theo danh mục
                                                window.location.href = `${url}?maDanhMuc=${maDanhMuc}&loai=1`;
                                            } else {
                                                // Click lần nữa → bỏ lọc (loại bỏ maDanhMuc)
                                                window.location.href = `${url}`;
                                            }
                                        });
                                    });
                                });
                            </script>
                        }
                    </ul>
                </div>

                <div class="sidebar__widget">
                    <h3 class="widget__title">Lọc Theo Giá</h3>
                    <div class="widget__content">
                        <div class="price-range">
                            <input type="range" min="0" max="500000" value="@(ViewBag.khoangGia ?? 500000)" class="price-range__slider" id="price-range-slider">
                            <span class="price-range__value" id="price-range-value">
                                Lên đến @(ViewBag.KhoangGia != null ? string.Format("{0:N0}đ", ViewBag.KhoangGia) : "500,000đ")
                                </span>
                        </div>
                    </div>
                </div>
                <script>
                    const slider = document.getElementById("price-range-slider");
                    const valueDisplay = document.getElementById("price-range-value");

                    // Cập nhật giá trị khi thanh trượt thay đổi
                    slider.addEventListener("input", function () {
                        const value = parseInt(this.value);
                        valueDisplay.textContent = "Lên đến " + value.toLocaleString('vi-VN') + "đ";

                    const baseUrl = '@Url.Action("SanPham", "CuaHang", new { area = "KhachHang" })';

                    const finalUrl = baseUrl + '?khoangGia=' + value + '&loai=3';

                    window.location.href = finalUrl;
                    });
                </script>

            </aside>

            <div class="shop__products">
                <div class="shop__header" style="width:228px">
                    <select class="sort-select form__input" id="sort-by" onchange="location = this.value;">
                        <option value="@Url.Action("SanPham", "CuaHang", new { area = "KhachHang", loaiXapXep = 1, loai = 2 })" @(ViewBag.LoaiXapXep == 1 ? "selected" : "")>Sắp xếp mặc định</option>
                        <option value="@Url.Action("SanPham", "CuaHang", new { area = "KhachHang", loaiXapXep = 2, loai = 2 })" @(ViewBag.LoaiXapXep == 2 ? "selected" : "")>Giá: Thấp đến Cao</option>
                        <option value="@Url.Action("SanPham", "CuaHang", new { area = "KhachHang", loaiXapXep = 3, loai = 2 })" @(ViewBag.LoaiXapXep == 3 ? "selected" : "")>Giá: Cao đến Thấp</option>
                        <option value="@Url.Action("SanPham", "CuaHang", new { area = "KhachHang", loaiXapXep = 4, loai = 2 })" @(ViewBag.LoaiXapXep == 4 ? "selected" : "")>Tên: A-Z</option>
                        <option value="@Url.Action("SanPham", "CuaHang", new { area = "KhachHang", loaiXapXep = 5, loai = 2 })" @(ViewBag.LoaiXapXep == 5 ? "selected" : "")>Tên: Z-A</option>
                        <option value="@Url.Action("SanPham", "CuaHang", new { area = "KhachHang", loaiXapXep = 6, loai = 2 })" @(ViewBag.LoaiXapXep == 6 ? "selected" : "")>Mới nhất</option>
                        <option value="@Url.Action("SanPham", "CuaHang", new { area = "KhachHang", loaiXapXep = 7, loai = 2 })" @(ViewBag.LoaiXapXep == 7 ? "selected" : "")>Cũ nhất</option>
                    </select>
                </div>
                <script>
                    document.getElementById("sort-by").addEventListener("change", function () {
                        var selectedUrl = this.value;
                        if (selectedUrl) {
                            window.location.href = selectedUrl;
                        }
                    });
                </script>

                <div class="products__container grid" id="shop-products__container">
                    @if (Model?.DanhSachSanPham != null && Model.DanhSachSanPham.Any())
                    {
                        @foreach (var sanPham in Model.DanhSachSanPham)
                        {
                            <div class="product__item shop-product__item shop-card">
                                <div class="product__banner">
                                    <a href="@Url.Action("ChiTietSanPham", "CuaHang", new { area = "KhachHang", maSanPham = sanPham.MaSanPham })" class="product__images">
                                        <img src="@Url.Content("~/KhachHang/images/" + sanPham.HinhAnhDaiDien)"
                                             alt="@sanPham.TenSanPham"
                                             class="product__img default" />
                                    </a>
                                </div>
                                <div class="product__content">
                                    <span class="product__category">@sanPham.TenDanhMuc</span>
                                    <a href="@Url.Action("ChiTietSanPham", "CuaHang", new { area = "KhachHang", maSanPham = sanPham.MaSanPham })">
                                        <h3 class="product__title">@sanPham.TenSanPham</h3>
                                    </a>
                                    <p class="product__description">@sanPham.MoTaNgan</p>
                                </div>
                                <div class="product__bottom-row">
                                    <div class="product__price">
                                        <span class="new__price">@string.Format("{0:N0}₫", sanPham.GiaBan)</span>
                                    </div>
                                    <div class="product-card-actions">
                                        <a href="#" class="action__btn" aria-label="Thêm yêu thích">
                                            <i class="fi fi-rs-heart"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p>Không có sản phẩm để hiển thị.</p>
                    }
                </div>
                <div class="pagination" id="pagination">
                    @if (Model.TongSoTrang > 1)
                    {
                        <!-- Nút « -->
                        <li>
                            <a class="pagination__link icon @(Model.TrangHienTai == 1 ? "disabled" : "")"
                               href="@Url.Action("SanPham", "CuaHang", 
                               new { area = "KhachHang", maDanhMuc = ViewBag.MaDanhMuc, loai = ViewBag.Loai, loaiXapXep = ViewBag.loaiXapXep, KhoangGia = ViewBag.KhoangGia, trang = Model.TrangHienTai - 1 })">
                                «
                            </a>
                        </li>

                        <!-- Các trang số -->
                        @for (int i = 1; i <= Model.TongSoTrang; i++)
                        {
                            <li>
                                <a class="pagination__link @(Model.TrangHienTai == i ? "active" : "")"
                                   href="@Url.Action("SanPham", "CuaHang", 
                                   new { area = "KhachHang", maDanhMuc = ViewBag.MaDanhMuc, loaiXapXep = ViewBag.loaiXapXep, loai = ViewBag.Loai, trang = i })">
                                    @i
                                </a>
                            </li>
                        }

                        <!-- Nút » -->
                        <li>
                            <a class="pagination__link icon @(Model.TrangHienTai == Model.TongSoTrang ? "disabled" : "")"
                               href="@Url.Action("SanPham", "CuaHang", 
                               new { area = "KhachHang", maDanhMuc = ViewBag.MaDanhMuc, loai = ViewBag.Loai, loaiXapXep = ViewBag.loaiXapXep, KhoangGia = ViewBag.KhoangGia, trang = Model.TrangHienTai + 1 })">
                                »
                            </a>
                        </li>
                    }

                </div>
            </div>
        </div>
    </section>
</main>