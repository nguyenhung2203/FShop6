@{
	Layout = "~/Areas/KhachHang/Views/Shared/CustomerLayout.cshtml";
	ViewData["Title"] = "Chi tiết sản phẩm";
}
@model FShop6.Areas.KhachHang.Models.BienTheChiTietModel
<main class="main">
	<!--=============== BREADCRUMB ===============-->
	<section class="breadcrumb">
		<ul class="breadcrumb__list flex container">
			<li><a href="index.html" class="breadcrumb__link">Trang chủ</a></li>
			<li><span class="breadcrumb__link">></span></li>
			<li><span class="breadcrumb__link"></span>Chi tiết sản phẩm</li>
			<li><span class="breadcrumb__link">></span></li>
			<li><span class="breadcrumb__link"></span>@Model.TenSanPham</li>
		</ul>
	</section>

	<!--=============== DETAILS ===============-->
	<div class="details__container container grid">
		<div class="details__group">
			<div class="slider">
				<button type="button" class="slide-btn prev" id="prev-btn">‹</button>
				@foreach (var image in Model.BienThe.Where(bt => bt.TinhTrang != "Ngừng kinh doanh" && bt.TinhTrang != "Hết hàng" && bt.SoLuongTon > 0))
				{
					<img src="~/KhachHang/images/@image.URL" alt="Ảnh sản phẩm lớn" class="details__big-img" />
				}
				<button type="button" class="slide-btn next" id="next-btn">›</button>
			</div>
		</div>
		<div class="details__group">

			<h3 class="details__title">@Model.TenSanPham</h3>
			<div class="details__price flex">
				<span class="new__price" id="product-price"></span> <!-- Hiển thị giá cho từng biến thể -->
				<span class="old__price" id="product-discount" style="margin-left: 10px; font-size:20px"></span>
			</div>
			<p class="short__description" style="word-break: break-word;">
				@Model.MoTa
			</p>
			<ul class="products__list">
				<li class="list__item flex">
					<i class="fi-rs-crown"></i> Nhận hàng nhanh chóng
				</li>
				<li class="list__item flex">
					<i class="fi-rs-credit-card"></i> Thanh toán khi nhận hàng
				</li>
			</ul>
			<div class="details__size flex">
				<span class="details__size-title">Loại</span>
				<ul class="size__list" style="display: flex; flex-wrap: wrap;">
					@foreach (var bienThe in Model.BienThe.Where(bt => bt.TinhTrang != "Ngừng kinh doanh" && bt.TinhTrang != "Hết hàng" && bt.SoLuongTon > 0))
					{
						<li style="margin: 10px;">
							<a href="#" class="size__link"
							   data-id="@bienThe.MaBienThe"
							   data-giaban="@bienThe.GiaBan"
							   data-giamgia="@bienThe.GiamGia"
							   data-soluong="@bienThe.SoLuongTon"
							   data-sku="@bienThe.SKU"
							   data-hinhanh="@bienThe.URL"
							   onclick="updateProductDetails(this)">
								@bienThe.LoaiBienThe
							</a>
						</li>
						
					}
				</ul>
			</div>
			<div class="details__action" style="align-items: center;">
				@using (Html.BeginForm("ThemGioHang", "GioHang", FormMethod.Post, new { area = "KhachHang" }))
				{
					@Html.Hidden("maSanPham", Model.MaSanPham, new { id = "hiddenMaSanPham" })
					@Html.Hidden("maBienThe", "", new { id = "hiddenMaBienThe" })
					<input id="nhap-so-luong" type="number" name="soLuong" class="quantity" value="1" min="1" max="" />
					<button type="submit" class="btn btn--sm">Thêm vào giỏ hàng</button>
				}

				<form id="yeuthich" action="@Url.Action("ThemYeuThich", "TaiKhoan", new { area = "KhachHang" })" method="post" style="margin-left: 20px;">
					<input type="hidden" name="giaoDien" value="chitiet" />
					<input type="hidden" name="maSanPham" value="@Model.MaSanPham" />
					<button type="submit" class="action__btn @(ViewBag.IsFavorite ? "favorite-active" : "")" aria-label="Thêm yêu thích">
						<i class="fi fi-rs-heart"></i>
					</button>
				</form>
			</div>

			<ul class="details__meta">
				<li class="meta__list flex">
					<span>SKU:</span> <span id="product-sku"></span>
				</li>
				<li class="meta__list flex">
					<span>Số lượng còn lại:</span> <span id="product-status"></span>
				</li>
			</ul>

		</div>
	</div>
	<br />
</main>

<script>
	document.querySelectorAll('.quantity-wrapper').forEach(wrapper => {
	  const input = wrapper.querySelector('.quantity');
	  const btnPlus = wrapper.querySelector('.plus');
	  const btnMinus = wrapper.querySelector('.minus');

	  btnPlus.addEventListener('click', () => {
		input.value = parseInt(input.value) + 1;
	  });

	  btnMinus.addEventListener('click', () => {
		if (parseInt(input.value) > parseInt(input.min)) {
		  input.value = parseInt(input.value) - 1;
		}
	  });
	});
</script>