@{
    Layout = "~/Areas/KhachHang/Views/Shared/CustomerLayout.cshtml";
    ViewData["Title"] = "Đặt Hàng Thành Công";
}
<main class="body-success">
    <div class="success-container">
        <div class="success-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
        </div>

        <h1 class="success-title">Đặt Hàng Thành Công!</h1>
        <p class="success-message">
            Cảm ơn bạn đã tin tưởng và mua sắm tại <strong>FShop6</strong>. Đơn hàng của bạn sẽ được xử lý ngay lập tức.
        </p>

        <div class="success-actions">
            <a asp-controller="Home" asp-action="Index" class="btn">Tiếp Tục Mua Sắm</a>
            <a asp-controller="Account" asp-action="Orders" class="success-link">Xem Lịch Sử Đơn Hàng</a>
        </div>
    </div>
</main>