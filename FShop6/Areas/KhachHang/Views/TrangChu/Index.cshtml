@{
    Layout = "~/Areas/KhachHang/Views/Shared/CustomerLayout.cshtml";
    ViewData["Title"] = "Trang chủ";
}
@model FShop6.Areas.KhachHang.Models.TrangChuViewModel
<main class="main">
    <!--=============== HOME ===============-->
    <section class="home section--lg">
        <div class="home__container container grid">
            <div class="home__content">
                <span class="home__subtitle">Sản phẩm độc quyền</span>
                <h1 class="home__title">
                    Bộ sưu tập <span>Thương hiệu FPT</span>
                </h1>
                <p class="home__description">
                    Thể hiện cá tính và niềm tự hào của sinh viên FPT.
                </p>
                <a href="@Url.Action("SanPham", "CuaHang", new { area = "KhachHang" })" class="btn">Mua sắm ngay</a>
            </div>
            <img src="~/KhachHang/images/banner.jpg" class="home__img" alt="Sản phẩm thương hiệu FPT" />
        </div>
    </section>

    <!--=============== STATS ===============-->
    <section class="stats section">
        <div class="stats__container container grid">
            <div class="stats__item features__item">
                <i class="fi fi-rs-star stats__icon"></i>
                <div class="stats__content">
                    <h3 class="stats__number">CHÍNH HÃNG</h3>
                    <p class="stats__text">Sản phẩm FPT PolySchool độc quyền</p>
                </div>
            </div>
            <div class="stats__item features__item">
                <i class="fi fi-rs-heart stats__icon"></i>
                <div class="stats__content">
                    <h3 class="stats__number">HANDMADE</h3>
                    <p class="stats__text">Chất lượng cao cấp</p>
                </div>
            </div>
            <div class="stats__item features__item">
                <i class="fi fi-rs-rocket stats__icon"></i>
                <div class="stats__content">
                    <h3 class="stats__number">EXPRESS</h3>
                    <p class="stats__text">Giao hàng siêu tốc</p>
                </div>
            </div>
            <div class="stats__item features__item">
                <i class="fi fi-rs-dollar stats__icon"></i>
                <div class="stats__content">
                    <h3 class="stats__number">STUDENT</h3>
                    <p class="stats__text">Giá ưu đãi sinh viên</p>
                </div>
            </div>
        </div>
    </section>
    <!--=============== Danh mục phổ biến ===============-->
    <section class="categories container section">
        <h3 class="section__title"><span>Danh mục phổ biến</span></h3>
        <div class="categories__container swiper">
            <div class="swiper-wrapper">
                @foreach (var dm in Model.DanhMucPhoBien)
                {
                    <a href="@Url.Action("SanPham", "CuaHang", new { area = "KhachHang", maDanhMuc = dm.Id, loai = 1 })" class="danhmuc category__item swiper-slide">
                        <img src=""
                             alt=""
                             class="category__img" />
                        <h3 class="category__title">@dm.TenDanhMuc</h3>
                    </a>
                }

            </div>

            <div class="swiper-button-prev">
                <i class="fi fi-rs-angle-left"></i>
            </div>
            <div class="swiper-button-next">
                <i class="fi fi-rs-angle-right"></i>
            </div>
        </div>
    </section>
    <!--=============== Sản phẩm nổi bật và phổ biến ===============-->
    <section class="products container section">
        <div class="tab__btns">
            <span class="tab__btn active-tab" data-target="#featured">Nổi bật</span>
            <span class="tab__btn" data-target="#popular">Sản phẩm bán chạy</span>
        </div>

        <div class="tab__items">
            <div class="tab__item active-tab" content id="featured">
                <div class="products__container grid">
                    @foreach (var sanPham in Model.SanPhamNoiBat)
                    {
                        <div class="product__item">
                            <div class="product__banner">
                                <a href="@Url.Action("ChiTietSanPham", "CuaHang", new { area = "KhachHang", maSanPham = sanPham.MaSanPham })" class="product__images">
                                    <img src="@("/KhachHang/images/" + sanPham.HinhAnhDaiDien)"
                                         alt="@sanPham.TenSanPham"
                                         class="product__img default" />
                                </a>
                                <div class="product__actions">
                                </div>
                                <div class="product__badge light-green">
                                    @(sanPham.GiamGia > 0 ? $"-{sanPham.GiamGia}%" : "Mua ngay")
                                </div>

                            </div>
                            <div class="product__content">
                                <div class="product__content-top">
                                    <span class="product__category">@sanPham.TenDanhMuc</span>
                                    <a href="@Url.Action("ChiTietSanPham", "CuaHang", new { area = "KhachHang", maSanPham = sanPham.MaSanPham })">
                                        <h3 class="product__title">@sanPham.TenSanPham</h3>
                                        <p class="product__sold">Đã bán (@sanPham.SoLuongDaBan)</p>
                                    </a>
                                </div>

                                <div class="product__content-middle">
                                    <div class="product__description-wrapper">
                                        <p class="product__description">@sanPham.MoTaNgan</p>
                                    </div>
                                </div>

                                <div class="product__content-bottom">
                                    <div>
                                        <span class="new__price">
                                            @string.Format("{0:N0}₫", sanPham.GiaBan * (100 - (sanPham.GiamGia ?? 0)) / 100)
                                        </span>
                                        @if (sanPham.GiamGia > 0)
                                        {
                                            <span class="old__price">@string.Format("{0:N0}₫", sanPham.GiaBan)</span>
                                        }
                                    </div>

                                    @using (Html.BeginForm("ThemYeuThich", "TaiKhoan", new { area = "KhachHang" }, FormMethod.Post))
                                    {
                                        @Html.Hidden("maSanPham", sanPham.MaSanPham)
                                        <button type="submit" class="action__btn @(sanPham.TinhTrangYeuThich ? "favorite-active" : "")" aria-label="Yêu thích">
                                            <i class="fi fi-rs-heart"></i>
                                        </button>
                                    }
                                </div>

                            </div>
                        </div>
                    }
                    @* Chỗ để đổ dữ liệu mới vào đây *@
                </div>
            </div>
        </div>
        <div class="tab__item" content id="popular">
            <div class="products__container grid">
                @foreach (var sanPham in Model.SanPhamPhoBien)
                    {
                    <div class="product__item">
                        <div class="product__banner">
                            <a href="@Url.Action("ChiTietSanPham", "CuaHang", new { area = "KhachHang", maSanPham = sanPham.MaSanPham })" class="product__images">
                                <img src="@("/KhachHang/images/" + sanPham.HinhAnhDaiDien)"
                                     alt="@sanPham.TenSanPham"
                                     class="product__img default" />
                            </a>
                            <div class="product__actions">
                            </div>
                            <div class="product__badge light-green">
                                @(sanPham.GiamGia > 0 ? $"-{sanPham.GiamGia}%" : "HOT")
                            </div>
                        </div>
                        <div class="product__content">
                            <div class="product__content-top">
                                <span class="product__category">@sanPham.TenDanhMuc</span>
                                <a href="@Url.Action("ChiTietSanPham", "CuaHang", new { area = "KhachHang", maSanPham = sanPham.MaSanPham })">
                                    <h3 class="product__title">@sanPham.TenSanPham</h3>
                                    <p class="product__sold">Đã bán (@sanPham.SoLuongDaBan)</p>
                                </a>
                            </div>

                            <div class="product__content-middle">
                                <div class="product__description-wrapper">
                                    <p class="product__description">@sanPham.MoTaNgan</p>
                                </div>
                            </div>

                            <div class="product__content-bottom">
                                <div>
                                    <span class="new__price">
                                        @string.Format("{0:N0}₫", sanPham.GiaBan * (100 - (sanPham.GiamGia ?? 0)) / 100)
                                    </span>
                                    @if (sanPham.GiamGia > 0)
                                    {
                                        <span class="old__price">@string.Format("{0:N0}₫", sanPham.GiaBan)</span>
                                    }
                                </div>

                                @using (Html.BeginForm("ThemYeuThich", "TaiKhoan", new { area = "KhachHang" }, FormMethod.Post))
                                {
                                    @Html.Hidden("maSanPham", sanPham.MaSanPham)
                                    <button type="submit" class="action__btn @(sanPham.TinhTrangYeuThich ? "favorite-active" : "")" aria-label="Yêu thích">
                                        <i class="fi fi-rs-heart"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                    }
            </div>
        </div>
    </section>

    <!--=============== Sản phẩm mới về ===============-->
    <section class="products container section">
        <h3 class="section__title"><span>Hàng mới về</span></h3>
        <div class="products__container grid">
            @foreach (var sanPham in Model.SanPhamMoi)
            {
                <div class="product__item">
                    <div class="product__banner">
                        <a href="@Url.Action("ChiTietSanPham", "CuaHang", new { area = "KhachHang", maSanPham = sanPham.MaSanPham })" class="product__images">
                            <img src="@("/KhachHang/images/" + sanPham.HinhAnhDaiDien)"
                                 alt="@sanPham.TenSanPham"
                                 class="product__img default" />
                        </a>
                        <div class="product__actions"></div>
                        <div class="product__badge light-green">New</div>
                    </div>

                    <div class="product__content">
                        <div class="product__content-top">
                            <span class="product__category">@sanPham.TenDanhMuc</span>
                            <a href="@Url.Action("ChiTietSanPham", "CuaHang", new { area = "KhachHang", maSanPham = sanPham.MaSanPham })">
                                <h3 class="product__title">@sanPham.TenSanPham</h3>
                            </a>
                        </div>

                        <div class="product__content-middle">
                            <div class="product__description-wrapper">
                                <p class="product__description">@sanPham.MoTaNgan</p>
                            </div>
                        </div>

                        <div class="product__content-bottom">
                            <div>
                                <span class="new__price">@string.Format("{0:N0}₫", sanPham.GiaBan)</span>
                            </div>

                            @using (Html.BeginForm("ThemYeuThich", "TaiKhoan", new { area = "KhachHang" }, FormMethod.Post))
                            {
                                @Html.Hidden("maSanPham", sanPham.MaSanPham)
                                <button type="submit" class="action__btn @(sanPham.TinhTrangYeuThich ? "favorite-active" : "")" aria-label="Yêu thích">
                                    <i class="fi fi-rs-heart"></i>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Features Section - Ưu điểm nổi bật -->
    <section class="features section">
        <div class="features__container container">
            <h3 class="section__title">
                <span>Tại sao chọn</span> FShop6?
            </h3>
            <div class="features__grid grid">
                <div class="features__item">
                    <div class="features__icon-box">
                        <i class="fi fi-rs-trophy features__icon"></i>
                    </div>
                    <div class="features__content">
                        <h4 class="features__title">Chất lượng đảm bảo</h4>
                        <p class="features__description">Sản phẩm chính hãng, được kiểm tra kỹ lưỡng trước khi giao đến tay khách hàng.</p>
                    </div>
                </div>
                <div class="features__item">
                    <div class="features__icon-box">
                        <i class="fi fi-rs-headphones features__icon"></i>
                    </div>
                    <div class="features__content">
                        <h4 class="features__title">Hỗ trợ 24/7</h4>
                        <p class="features__description">Đội ngũ tư vấn chuyên nghiệp, sẵn sàng hỗ trợ khách hàng mọi lúc mọi nơi.</p>
                    </div>
                </div>
                <div class="features__item">
                    <div class="features__icon-box">
                        <i class="fi fi-rs-refresh features__icon"></i>
                    </div>
                    <div class="features__content">
                        <h4 class="features__title">Đổi trả dễ dàng</h4>
                        <p class="features__description">Chính sách đổi trả linh hoạt trong 7 ngày, không cần lý do.</p>
                    </div>
                </div>
                <div class="features__item">
                    <div class="features__icon-box">
                        <i class="fi fi-rs-dollar features__icon"></i>
                    </div>
                    <div class="features__content">
                        <h4 class="features__title">Giá cả hợp lý</h4>
                        <p class="features__description">Cam kết giá tốt nhất thị trường với nhiều ưu đãi hấp dẫn cho sinh viên.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--=============== TIN TỨC ===============-->
    <section class="news section container">
        <h3 class="section__title"><span>Tin tức</span> & Bài viết</h3>

        <div class="news__container grid">
            @foreach (var tinTuc in Model.TinTuc)
            {
                <div class="news__item">
                    <div class="news__content">
                        <div class="news__meta">
                            <span class="news__author">bởi Admin</span>
                            <span class="news__date">@tinTuc.ThoiGianTao</span>
                        </div>
                        <a href="blog-post.html">
                            <h3 class="news__title">@tinTuc.TieuDe</h3>
                        </a>
                        <p class="news__description">
                            @(tinTuc.MoTaNgan + "...")
                        </p>
                        <a href="@Url.Action("ChiTietTinTuc", "TinTuc", new { area = "KhachHang", id = tinTuc.MaTinTuc })" class="news__readmore">
                            Đọc thêm <i class="fi fi-rs-arrow-right"></i>
                        </a>

                    </div>
                </div>
            }

        </div>
    </section>
</main>
<style>
    .product__content-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between; /* hoặc flex-end nếu muốn dồn về bên phải */
        gap: 8px; /* khoảng cách giữa các phần tử */
    }

        .product__content-bottom .new__price,
        .product__content-bottom .old__price {
            display: inline-block;
        }

        .product__content-bottom form {
            margin: 0; /* bỏ khoảng cách form mặc định */
        }

</style>