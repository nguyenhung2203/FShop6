@{
    Layout = "~/Areas/KhachHang/Views/Shared/CustomerLayout.cshtml";
    ViewData["Title"] = "Trang chủ";
}
@model FShop6.Areas.KhachHang.Models.TrangChuViewModel
<main class="main">
    <!--=============== HOME ===============-->
    <section class="home section--lg">
        <div class="home__container container grid">
            <div class="home__content">
                <span class="home__subtitle">Sản phẩm độc quyền</span>
                <h1 class="home__title">
                    Bộ sưu tập <span>Thương hiệu FPT</span>
                </h1>
                <p class="home__description">
                    Thể hiện cá tính và niềm tự hào của sinh viên FPT.
                </p>
                <a href="@Url.Action("SanPham", "CuaHang", new { area = "KhachHang" })" class="btn">Mua sắm ngay</a>
            </div>
            <img src="~/KhachHang/images/Anh2Bannner-fotor-20250722152618.png" class="home__img" alt="Sản phẩm thương hiệu FPT" />
        </div>
    </section>

    <!--=============== Danh mục phổ biến ===============-->
    <section class="categories container section">
        <h3 class="section__title"><span>Danh mục phổ biến</span></h3>
        <div class="categories__container swiper">
            <div class="swiper-wrapper">
                 @foreach (var danhMuc in Model.DanhMucPhoBien)
                {
                    <a href="shop.html" class="category__item swiper-slide">
                        <img src="assets/img/category-1.jpg"
                             alt=""
                             class="category__img" />
                        <h3 class="category__title">@danhMuc.TenDanhMuc</h3>
                    </a>
                }

            </div>

            <div class="swiper-button-prev">
                <i class="fi fi-rs-angle-left"></i>
            </div>
            <div class="swiper-button-next">
                <i class="fi fi-rs-angle-right"></i>
            </div>
        </div>
    </section>

    <!--=============== Sản phẩm nổi bật và phổ biến ===============-->
    <section class="products container section">
        <div class="tab__btns">
            <span class="tab__btn active-tab" data-target="#featured">Nổi bật</span>
            <span class="tab__btn" data-target="#popular">Phổ biến</span>
        </div>

        <div class="tab__items">
            <div class="tab__item active-tab" content id="featured">
                <div class="products__container grid">
                   @foreach(var sanPham in Model.SanPhamNoiBat)
                    {
                        <div class="product__item swiper-slide">
                            <div class="product__banner">
                                <a href="details.html" class="product__images">
                                    <img src="@("/KhachHang/images/" + sanPham.HinhAnhDaiDien)"
                                         alt="@sanPham.TenSanPham"
                                         class="product__img default" />
                                </a>
                            </div>
                            <div class="product__content">
                                <a href="details.html">
                                    <h3 class="product__title">@sanPham.TenSanPham</h3>
                                </a>
                                <p class="product__description">@sanPham.MoTaNgan</p>
                            </div>
                            <div class="product__bottom-row">
                                <div class="product__price flex">
                                    <span class="new__price">@string.Format("{0:N0}₫", sanPham.GiaBan)</span>
                                </div>
                                <div class="product-card-actions">
                                    <a href="#" class="action__btn cart__btn" aria-label="Add To Cart">
                                        <i class="fi fi-rs-shopping-bag-add"></i>
                                    </a>
                                    <a href="#" class="action__btn" aria-label="Add to Wishlist">
                                        <i class="fi fi-rs-heart"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="tab__item" content id="popular">
                <div class="products__container grid">
                    @foreach (var sanPham in Model.SanPhamPhoBien)
                    {
                        <div class="product__item swiper-slide">
                            <div class="product__banner">
                                <a href="details.html" class="product__images">
                                    <img src="@("/KhachHang/images/" + sanPham.HinhAnhDaiDien)"
                                         alt="@sanPham.TenSanPham"
                                         class="product__img default" />
                                </a>
                            </div>
                            <div class="product__content">
                                <a href="details.html">
                                    <h3 class="product__title">@sanPham.TenSanPham</h3>
                                </a>
                                <p class="product__description">@sanPham.MoTaNgan</p>
                            </div>
                            <div class="product__bottom-row">
                                <div class="product__price flex">
                                    <span class="new__price">@string.Format("{0:N0}₫", sanPham.GiaBan)</span>
                                </div>
                                <div class="product-card-actions">
                                    <a href="#" class="action__btn cart__btn" aria-label="Add To Cart">
                                        <i class="fi fi-rs-shopping-bag-add"></i>
                                    </a>
                                    <a href="#" class="action__btn" aria-label="Add to Wishlist">
                                        <i class="fi fi-rs-heart"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>

    <!--=============== Sản phẩm mới về ===============-->
    <section class="new__arrivals container section">
        <h3 class="section__title"><span>Hàng mới về</span></h3>
        <div class="new__container swiper">
            <div class="swiper-wrapper">
                @foreach (var sanPham in Model.SanPhamMoi)
                {
                    <div class="product__item swiper-slide">
                        <div class="product__banner">
                            <a href="details.html" class="product__images">
                                <img src="@("/KhachHang/images/" + sanPham.HinhAnhDaiDien)"
                                     alt="@sanPham.TenSanPham"
                                     class="product__img default" />
                            </a>
                        </div>
                        <div class="product__content">
                            <a href="details.html">
                                <h3 class="product__title">@sanPham.TenSanPham</h3>
                            </a>
                            <p class="product__description">@sanPham.MoTaNgan</p>
                        </div>
                        <div class="product__bottom-row">
                            <div class="product__price flex">
                                <span class="new__price">@string.Format("{0:N0}₫", sanPham.GiaBan)</span>
                            </div>
                            <div class="product-card-actions">
                                <a href="#" class="action__btn cart__btn" aria-label="Add To Cart">
                                    <i class="fi fi-rs-shopping-bag-add"></i>
                                </a>
                                <a href="#" class="action__btn" aria-label="Add to Wishlist">
                                    <i class="fi fi-rs-heart"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
            </div>

            <div class="swiper-button-prev">
                <i class="fi fi-rs-angle-left"></i>
            </div>
            <div class="swiper-button-next">
                <i class="fi fi-rs-angle-right"></i>
            </div>
        </div>
    </section>
    <section class="new__arrivals container section">
    </section>

    <!--=============== TIN TỨC ===============-->
    <section class="news section container">
        <h3 class="section__title"><span>Tin tức</span> & Bài viết</h3>

        <div class="news__container grid">
            @foreach (var tinTuc in Model.TinTuc)
            {
                <div class="news__item">
                    <div class="news__banner">
                    <a href="blog-post.html">
                        <img src="assets/img/home-img.png" alt="Ảnh tin tức" class="news__img">
                    </a>
                </div>
                <div class="news__content">
                    <div class="news__meta">
                        <span class="news__author">bởi Admin</span>
                        <span class="news__date">@tinTuc.ThoiGianTao</span>
                    </div>
                    <a href="blog-post.html">
                        <h3 class="news__title">@tinTuc.TieuDe</h3>
                    </a>
                    <p class="news__description">
                        @(tinTuc.MoTaNgan + "...")
                    </p>
                    <a href="blog-post.html" class="news__readmore">Đọc thêm <i class="fi fi-rs-arrow-right"></i></a>
                </div>
            </div>
            }

        </div>
    </section>

    <section class="showcase section">
    </section>
    <!--=============== SHOWCASE ===============-->
    <section class="showcase section">
        <div class="showcase__container container grid">
            @foreach (var danhMuc in Model.DanhMucSanPhamHienThi)
            {
                <div class="showcase__wrapper">
                    <h3 class="section__title">@danhMuc.TenDanhMuc</h3>

                    @foreach (var sanPham in danhMuc.SanPhams)
                    {
                        <div class="showcase__item">
                            <a href="details.html" class="showcase__img-box">
                                <img src="@("/KhachHang/images/" + sanPham.HinhAnhDaiDien)"
                                     alt="@sanPham.TenSanPham"
                                     class="showcase__img" />
                            </a>
                            <div class="showcase__content">
                                <a href="details.html">
                                    <h4 class="showcase__title">@sanPham.TenSanPham</h4>
                                </a>
                                <div class="showcase__price flex">
                                    <span class="new__price">@string.Format("{0:N0}₫", sanPham.GiaBan)</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
</main>

