
<header class="header">
    <div class="header__top">
        <div class="header__container container">
            <a href="@Url.Action("Index", "TrangChu", new { area = "KhachHang" })" class="nav__logo">
                <img class="nav__logo-img" src="~/KhachHang/images/logo.png" alt="logo website" />
            </a>
            <div class="header__slogan">
                <p>FShop6 - Chất từ giảng đường FPT</p>
            </div>

            <div class="topbar-message">
                <span>📞 Hotline hỗ trợ: 0328 131 562 (8h - 21h hàng ngày)</span>
            </div>

            <div class="action-item" id="account-menu">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                     viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
                <span id="account-text">Tài khoản</span>
                <div class="account-dropdown" id="account-dropdown-content"></div>
            </div>
        </div>
    </div>
    <nav class="nav container" id="nav-container">
        <div class="nav__menu" id="nav-menu">
            <div class="nav__menu-top">
                <div class="nav__close" id="nav-close">
                    <i class="fi fi-rs-cross-small"></i>
                </div>
            </div>
            <ul class="nav__list">
                <li class="nav__item">
                    <a href="@Url.Action("Index", "TrangChu", new { area = "KhachHang" })" class="nav__link">
                        <svg class="icon" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
                        </svg>
                        Trang chủ</a>
                </li>
                <li class="nav__item">
                    <a href="@Url.Action("SanPham", "CuaHang", new { area = "KhachHang" })" class="nav__link">
                        <svg class="icon" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 2L3 7v11a2 2 0 002 2h10a2 2 0 002-2V7l-7-5zM6 9a1 1 0 112 0 1 1 0 01-2 0zm6 0a1 1 0 112 0 1 1 0 01-2 0z" />
                        </svg>
                        Sản phẩm</a>
                </li>
                <li class="nav__item">
                    <a href="@Url.Action("TinTuc", "TinTuc", new { area = "KhachHang" })" class="nav__link">
                        <svg class="icon" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M2 5a2 2 0 012-2h8a2 2 0 012 2v10a2 2 0 002 2H4a2 2 0 01-2-2V5zm3 1h6v4H5V6zm6 6H5v2h6v-2z" clip-rule="evenodd" />
                        </svg>
                        Tin tức</a>
                </li>
                <li class="nav__item">
                    <a href="@Url.Action("LienHe", "LienHe", new { area = "KhachHang" })" class="nav__link">
                        <svg class="icon" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
                            <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
                        </svg>
                        Liên hệ</a>
                </li>
                <li class="nav__item">
                    <a href="@Url.Action("GioiThieu", "LienHe", new { area = "KhachHang" })" class="nav__link">
                        <svg class="icon" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                        </svg>
                        Giới thiệu</a>
                </li>
            </ul>
            <div class="header__search">
                <input type="text" placeholder="Tìm kiếm sản phẩm..." class="form__input" />
                <button class="search__btn">
                    <img src="~/KhachHang/images/search.png" alt="icon tìm kiếm" />
                </button>
            </div>
        </div>

        <div class="header__user-actions">
            <a href="@Url.Action("SanPhamYeuThich", "TaiKhoan", new { area = "KhachHang" })" class="header__action-btn" title="Yêu thích">
                <i class="fi fi-rs-heart"></i><span class="count">0</span>
            </a>
            <a href="@Url.Action("GioHang", "GioHang", new { area = "KhachHang" })" class="header__action-btn" title="Giỏ hàng">
                <i class="fi fi-rs-shopping-bag-add"></i><span class="count">0</span>
            </a>
            <div class="header__action-btn nav__toggle" id="nav-toggle">
                <img src="~/assets/img/menu-burger.svg" alt="">
            </div>
        </div>
    </nav>
</header>